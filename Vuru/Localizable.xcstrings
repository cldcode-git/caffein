    "Önce şu anki nabzına bakalım. Parmağını kameraya hafifçe koy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First, let's check your heart rate. Rest your finger gently on the camera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce şu anki nabzına bakalım. Parmağını kameraya hafifçe koy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنلقِ نظرة أولًا على نبضك الحالي. ضع إصبعك برفق على الكاميرا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে আপনার এখনকার হার্ট রেট দেখে নিই। ক্যামেরায় আঙুল আলতো করে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schauen wir zuerst auf deinen aktuellen Puls. Leg deinen Finger sanft auf die Kamera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero, veamos tu pulso actual. Apoya el dedo suavemente sobre la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commençons par ton pouls actuel. Pose doucement ton doigt sur l'appareil photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले आपकी अभी की धड़कन देखते हैं। उंगली कैमरे पर हल्के से रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertama, mari lihat detak jantungmu sekarang. Letakkan jarimu perlahan di kamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、いまの心拍数を見てみましょう。指をカメラにそっと置いてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, vamos ver sua frequência cardíaca agora. Apoie o dedo de leve na câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала посмотрим на твой текущий пульс. Слегка приложи палец к камере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先看看你现在的心率。把手指轻轻放在摄像头上。"
          }
        }
      }
    },
