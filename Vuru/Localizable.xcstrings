    "Kahveden önce 60 saniyelik sabah ölçümünü yap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take your 60-second morning measurement before coffee."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahveden önce 60 saniyelik sabah ölçümünü yap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجرِ قياس الصباح لمدة 60 ثانية قبل القهوة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কফির আগে 60 সেকেন্ডের সকালের মাপ নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
