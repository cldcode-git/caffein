    "Nabzı da ölç": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure heart rate too"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabzı da ölç"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِس النبض أيضًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হার্ট রেটও মাপুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Puls messen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medir también el pulso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurer aussi le pouls"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धड़कन भी मापें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur detak jantung juga"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数も測る"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Medir os batimentos também"
          }
        },
