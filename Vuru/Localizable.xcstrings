    "Kahveni bırakma, tanı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't quit coffee, understand it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahveni bırakma, tanı"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتخلَّ عن قهوتك، بل افهمها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কফি ছাড়বেন না, বুঝে নিন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaffee nicht aufgeben, sondern verstehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No dejes el café: entiéndelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'arrête pas le café, comprends-le"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉफ़ी छोड़ें नहीं, उसे समझें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak perlu berhenti ngopi, kenali saja"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーヒーをやめずに、よく知ろう"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não largue o café, entenda-o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не бросай кофе — пойми его"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不必戒掉咖啡，而是了解它"
          }
        }
      }
    },
    "Kalp rahatsızlığın varsa ya da ilaç kullanıyorsan doktoruna danış.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have a heart condition or take medication, ask your doctor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalp rahatsızlığın varsa ya da ilaç kullanıyorsan doktoruna danış."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تعاني من مرض في القلب أو تتناول أدوية، فاستشر طبيبك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হার্টের কোনো সমস্যা থাকলে বা কোনো ওষুধ খেলে আপনার ডাক্তারের পরামর্শ নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Herzerkrankung hast oder Medikamente nimmst, sprich mit deinem Arzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes alguna enfermedad del corazón o tomas medicación, consulta a tu médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as un problème cardiaque ou prends des médicaments, demande l'avis de ton médecin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपको दिल की कोई बीमारी है या आप कोई दवा लेते हैं, तो अपने डॉक्टर से पूछें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau kamu punya penyakit jantung atau sedang minum obat, tanyakan ke doktermu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心臓の病気がある方や薬を服用中の方は、医師に相談してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você tem algum problema cardíaco ou toma remédios, consulte seu médico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у тебя есть болезнь сердца или ты принимаешь лекарства, посоветуйся с врачом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你有心脏疾病或正在服药，请咨询医生。"
          }
        }
      }
    },
    "Kamera başlatılamadı.": {
