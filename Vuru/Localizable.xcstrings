    "Hamilelik ve emzirme döneminde önerilen en fazla 200 mg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most 200 mg, as recommended during pregnancy and breastfeeding."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamilelik ve emzirme döneminde önerilen en fazla 200 mg."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "200 mg كحد أقصى، وهو الموصى به أثناء الحمل والرضاعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গর্ভাবস্থা ও স্তন্যদানের সময় সর্বোচ্চ 200 mg-এর পরামর্শ দেওয়া হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens 200 mg – empfohlen in Schwangerschaft und Stillzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo 200 mg, lo recomendado durante el embarazo y la lactancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "200 mg maximum, comme recommandé pendant la grossesse et l'allaitement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्भावस्था और स्तनपान के दौरान अधिकतम 200 mg की सलाह दी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimal 200 mg, sesuai anjuran selama hamil dan menyusui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "妊娠中・授乳中の推奨上限は200 mgです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo 200 mg, como recomendado na gravidez e na amamentação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не более 200 mg — рекомендация при беременности и грудном вскармливании."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孕期和哺乳期建议每日最多200 mg。"
          }
        }
      }
    },
