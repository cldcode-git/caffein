          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبقى نحو %lld ث"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর প্রায় %lld সেকেন্ড"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch etwa %lld s"
          }
        },
        "es": {
          "stringUnit": {
