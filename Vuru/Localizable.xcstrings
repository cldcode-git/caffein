    "Bayılma, bayılacak gibi olma ya da şiddetli baş dönmesi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fainting, feeling faint or severe dizziness"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayılma, bayılacak gibi olma ya da şiddetli baş dönmesi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغماء أو شعور بقرب الإغماء أو دوخة شديدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অজ্ঞান হয়ে যাওয়া, অজ্ঞান হয়ে যাবেন মনে হওয়া বা তীব্র মাথা ঘোরা"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohnmacht, das Gefühl, gleich ohnmächtig zu werden, oder starker Schwindel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmayo, sensación de desmayo o mareo intenso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évanouissement, sensation de malaise ou vertiges intenses"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहोश होना, बेहोशी जैसा लगना या तेज़ चक्कर आना"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pingsan, merasa mau pingsan, atau pusing hebat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失神、気が遠くなる感じ、または強いめまい"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmaio, sensação de desmaio ou tontura forte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обморок, предобморочное состояние или сильное головокружение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晕厥、快要晕倒或严重头晕"
          }
        }
      }
    },
