    "Dinlenme nabzın %lld, normalinden %lld atım düşük.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your resting heart rate is %lld, %lld bpm below your normal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlenme nabzın %lld, normalinden %lld atım düşük."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نبضك أثناء الراحة %lld، أي أقل من معدلك الطبيعي بـ %lld نبضة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিশ্রামকালীন হার্ট রেট %lld, স্বাভাবিকের চেয়ে %lld বিট কম।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ruhepuls ist %lld, %lld Schläge unter deinem Normalwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso en reposo es %lld, %lld lpm por debajo de tu normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls au repos est de %lld, soit %lld bpm sous ta normale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम के समय आपकी धड़कन %lld है, आपके सामान्य से %lld बीट कम।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung istirahatmu %lld, %lld bpm di bawah normalmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安静時心拍数は%lldで、いつもより%lld bpm低めです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frequência cardíaca em repouso é %lld, %lld bpm abaixo do seu normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс покоя %lld — на %lld уд./мин ниже твоей нормы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的静息心率为%lld，比你的正常值低%lld次/分。"
          }
        }
      }
    },
    "Dinlenme nabzın %lld, normalinden %lld atım yüksek. Uykusuzluk, stres, hastalık ya da dünkü geç kafein bunu etkileyebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your resting heart rate is %lld, %lld bpm above your normal. Poor sleep, stress, illness or late caffeine yesterday can do this."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlenme nabzın %lld, normalinden %lld atım yüksek. Uykusuzluk, stres, hastalık ya da dünkü geç kafein bunu etkileyebilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نبضك أثناء الراحة %lld، أي أعلى من معدلك الطبيعي بـ %lld نبضة. قد يكون السبب قلة النوم أو التوتر أو المرض أو تناول الكافيين في وقت متأخر أمس."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিশ্রামকালীন হার্ট রেট %lld, স্বাভাবিকের চেয়ে %lld বিট বেশি। কম ঘুম, স্ট্রেস, অসুস্থতা বা গতকাল দেরিতে নেওয়া ক্যাফেইন এর কারণ হতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ruhepuls ist %lld, %lld Schläge über deinem Normalwert. Schlechter Schlaf, Stress, Krankheit oder spätes Koffein gestern können das bewirken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso en reposo es %lld, %lld lpm por encima de tu normal. Dormir mal, el estrés, una enfermedad o la cafeína tardía de ayer pueden influir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls au repos est de %lld, soit %lld bpm au-dessus de ta normale. Un manque de sommeil, le stress, une maladie ou de la caféine prise tard hier peuvent jouer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम के समय आपकी धड़कन %lld है, आपके सामान्य से %lld बीट ज़्यादा। कम नींद, तनाव, बीमारी या कल देर से लिया गया कैफ़ीन इसकी वजह हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung istirahatmu %lld, %lld bpm di atas normalmu. Kurang tidur, stres, sakit, atau kafein yang terlambat kemarin bisa menyebabkannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安静時心拍数は%lldで、いつもより%lld bpm高めです。睡眠不足、ストレス、体調不良、前日の遅い時間のカフェインが影響している可能性があります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frequência cardíaca em repouso é %lld, %lld bpm acima do seu normal. Noite mal dormida, estresse, doença ou cafeína tarde ontem podem causar isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс покоя %lld — на %lld уд./мин выше твоей нормы. Так бывает из-за недосыпа, стресса, болезни или позднего кофеина накануне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的静息心率为%lld，比你的正常值高%lld次/分。睡眠不足、压力、生病或昨天较晚摄入咖啡因都可能导致这种情况。"
          }
        }
      }
    },
    "Dinlenme nabzın %lld, normalinle (%lld) aynı düzeyde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your resting heart rate is %lld, in line with your normal (%lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlenme nabzın %lld, normalinle (%lld) aynı düzeyde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نبضك أثناء الراحة %lld، وهو في مستوى معدلك الطبيعي (%lld)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিশ্রামকালীন হার্ট রেট %lld, আপনার স্বাভাবিকের (%lld) সমান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ruhepuls ist %lld und liegt bei deinem Normalwert (%lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso en reposo es %lld, en línea con tu normal (%lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls au repos est de %lld, dans ta normale (%lld)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम के समय आपकी धड़कन %lld है, आपके सामान्य (%lld) के बराबर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung istirahatmu %lld, sejalan dengan normalmu (%lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安静時心拍数は%lldで、いつもの値（%lld）と同じくらいです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frequência cardíaca em repouso é %lld, no mesmo nível do seu normal (%lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс покоя %lld — на уровне твоей нормы (%lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的静息心率为%lld，与你的正常值（%lld）持平。"
          }
        }
      }
    },
    "Dinlenme nabzın %lld. Kişisel normalin %lld sabah ölçümüyle oluşur; şu an %lld ölçümün var.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your resting heart rate is %lld. Your personal normal forms after %lld morning measurements; you have %lld so far."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlenme nabzın %lld. Kişisel normalin %lld sabah ölçümüyle oluşur; şu an %lld ölçümün var."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نبضك أثناء الراحة %lld. يتكوّن معدلك الطبيعي الشخصي بعد %lld من القياسات الصباحية؛ لديك حتى الآن %lld منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বিশ্রামকালীন হার্ট রেট %lld। %lldটি সকালের মাপের পর আপনার ব্যক্তিগত স্বাভাবিক মাত্রা তৈরি হয়; এখন পর্যন্ত আপনার %lldটি মাপ আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ruhepuls ist %lld. Dein persönlicher Normalwert entsteht nach %lld Morgenmessungen; bisher hast du %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso en reposo es %lld. Tu normal personal se forma tras %lld mediciones matutinas; llevas %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls au repos est de %lld. Ta normale personnelle s'établit après %lld mesures du matin ; tu en as %lld pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम के समय आपकी धड़कन %lld है। आपका निजी सामान्य स्तर %lld सुबह के मापों के बाद बनता है; अभी आपके पास %lld माप हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung istirahatmu %lld. Nilai normal pribadimu terbentuk setelah %lld pengukuran pagi; sejauh ini kamu punya %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安静時心拍数は%lldです。あなたの基準値は朝の測定%lld回分で作られます。現在%lld回です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frequência cardíaca em repouso é %lld. Seu normal pessoal se forma com %lld medições matinais; você tem %lld até agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс покоя %lld. Личная норма сложится после утренних замеров (нужно: %lld); сейчас их %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的静息心率为%lld。你的个人正常值需要%lld次晨间测量才能建立；目前已有%lld次。"
          }
        }
      }
    },
    "Dinlenmene rağmen dakikalarca geçmeyen çok hızlı ya da düzensiz kalp atışı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A very fast or irregular heartbeat that doesn't settle after minutes of rest"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlenmene rağmen dakikalarca geçmeyen çok hızlı ya da düzensiz kalp atışı"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نبض سريع جدًا أو غير منتظم لا يهدأ بعد دقائق من الراحة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্রাম নেওয়ার পরও কয়েক মিনিট ধরে না কমা খুব দ্রুত বা অনিয়মিত হৃৎস্পন্দন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr schneller oder unregelmäßiger Herzschlag, der sich auch nach Minuten der Ruhe nicht beruhigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Latidos muy rápidos o irregulares que no se calman tras varios minutos de reposo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Battements très rapides ou irréguliers qui ne se calment pas après plusieurs minutes de repos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम करने के बावजूद कई मिनट तक बनी रहने वाली बहुत तेज़ या अनियमित धड़कन"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung sangat cepat atau tidak teratur yang tidak mereda setelah beristirahat beberapa menit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数分休んでもおさまらない、とても速い、または不規則な心拍"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Batimentos muito rápidos ou irregulares que não passam após vários minutos de repouso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень частое или неровное сердцебиение, которое не проходит после нескольких минут отдыха"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休息几分钟后仍未缓解的极快或不规则心跳"
          }
        }
      }
    },
