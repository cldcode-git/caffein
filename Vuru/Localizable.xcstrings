    "Son kahve saatini buna göre hesaplıyoruz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We work out your last-coffee time from this."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kahve saatini buna göre hesaplıyoruz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحسب آخر موعد لقهوتك بناءً على هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এর ভিত্তিতেই আমরা আপনার শেষ কফির সময় হিসাব করি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach berechnen wir die Zeit für deinen letzten Kaffee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculamos la hora de tu último café a partir de esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous calculons l'heure de ton dernier café à partir de cela."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आखिरी कॉफ़ी का समय हम इसी से निकालते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari sini kami menghitung waktu kopi terakhirmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをもとに最後のコーヒー時刻を計算します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculamos o horário do seu último café com base nisso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По нему мы рассчитываем время последнего кофе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们据此计算你最后一杯咖啡的时间。"
          }
        }
      }
    },
    "Son kahveni biraz öne almayı dene": {
      "localizations": {
