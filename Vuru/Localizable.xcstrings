            "state": "translated",
            "value": "Kurva kafein"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェイン曲線"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva de cafeína"
          }
        },
