    "Uygulama hemen değişir. İzin pencereleri ve bildirimler uygulama yeniden açılınca değişir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app changes right away. Permission prompts and notifications change after the app is reopened."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hemen değişir. İzin pencereleri ve bildirimler uygulama yeniden açılınca değişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتغير التطبيق فورًا. أما نوافذ الأذونات والإشعارات فتتغير بعد إعادة فتح التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ সঙ্গে সঙ্গে বদলে যায়। অনুমতির বার্তা আর নোটিফিকেশন অ্যাপ আবার খুললে বদলাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ändert sich sofort. Berechtigungsdialoge und Mitteilungen ändern sich nach einem Neustart der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app cambia al instante. Los avisos de permisos y las notificaciones cambian al volver a abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app change immédiatement. Les demandes d'autorisation et les notifications changent après réouverture de l'app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप तुरंत बदल जाता है। अनुमति वाले संदेश और सूचनाएँ ऐप दोबारा खोलने पर बदलेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi langsung berubah. Jendela izin dan notifikasi berubah setelah aplikasi dibuka ulang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはすぐに切り替わります。許可ダイアログと通知は、アプリを開き直したあとに切り替わります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O app muda na hora. Os pedidos de permissão e as notificações mudam quando o app for reaberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение изменится сразу. Окна разрешений и уведомления — после перезапуска приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会立即切换。权限弹窗和通知会在重新打开应用后切换。"
          }
        }
      }
    },
