    "Tüm kayıtların yalnızca bu telefonda saklanır. Hesap yok, sunucu yok, reklam yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your records stay on this phone. No account, no server, no ads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kayıtların yalnızca bu telefonda saklanır. Hesap yok, sunucu yok, reklam yok."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ جميع سجلاتك على هذا الهاتف فقط. لا حساب، ولا خادم، ولا إعلانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সব রেকর্ড শুধু এই ফোনেই থাকে। অ্যাকাউন্ট নেই, সার্ভার নেই, বিজ্ঞাপন নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einträge bleiben nur auf diesem Handy. Kein Konto, kein Server, keine Werbung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus registros se quedan solo en este teléfono. Sin cuenta, sin servidor, sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes tes données restent uniquement sur ce téléphone. Pas de compte, pas de serveur, pas de pub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सारे रिकॉर्ड सिर्फ़ इसी फ़ोन पर रहते हैं। न अकाउंट, न सर्वर, न विज्ञापन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua catatanmu hanya disimpan di ponsel ini. Tanpa akun, tanpa server, tanpa iklan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はすべてこのiPhoneの中だけに保存されます。アカウントなし、サーバーなし、広告なし。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus registros ficam só neste celular. Sem conta, sem servidor, sem anúncios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все твои записи хранятся только на этом телефоне. Без аккаунта, без сервера, без рекламы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的所有记录只保存在这部手机上。没有账号，没有服务器，没有广告。"
          }
        }
      }
    },
