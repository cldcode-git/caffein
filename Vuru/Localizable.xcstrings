    "Yatarken vücudunda %@'den fazla kafein kalan %lld gecede ortalama %@ daha az uyudun.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %2$lld nights you went to bed with more than %1$@ of caffeine, you slept %3$@ less on average."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken vücudunda %@'den fazla kafein kalan %lld gecede ortalama %@ daha az uyudun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %2$lld من الليالي التي ذهبت فيها إلى النوم وفي جسمك أكثر من %1$@ من الكافيين، نمت أقل بمعدل %3$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময় শরীরে %@-এর বেশি ক্যাফেইন থাকা %lld রাতে আপনি গড়ে %@ কম ঘুমিয়েছেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %2$lld Nächten mit mehr als %1$@ Koffein im Körper beim Zubettgehen hast du im Schnitt %3$@ weniger geschlafen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %2$lld noches que te acostaste con más de %1$@ de cafeína en el cuerpo, dormiste de media %3$@ menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %2$lld nuits où ton corps contenait plus de %1$@ de caféine au coucher, tu as dormi en moyenne %3$@ de moins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोते समय शरीर में %@ से ज़्यादा कैफ़ीन वाली %lld रातों में आप औसतन %@ कम सोए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada %2$lld malam saat kamu tidur dengan lebih dari %1$@ kafein di tubuh, kamu rata-rata tidur %3$@ lebih singkat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時に体内のカフェインが%@を超えていた%lld晩は、睡眠時間が平均%@短くなりました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas %2$lld noites em que você foi dormir com mais de %1$@ de cafeína no corpo, dormiu em média %3$@ a menos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ночей, когда к отбою в организме было больше %@ кофеина: %lld. В эти ночи сон был в среднем на %@ короче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前体内咖啡因超过%@的%lld个晚上，你平均少睡了%@。"
          }
        }
      }
    },
    "Yatarken vücudunda %@'den fazla kafein kalan %lld gecede uyku puanın ortalama %@ puan daha düşüktü.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %2$lld nights you went to bed with more than %1$@ of caffeine, your sleep score was %3$@ points lower on average."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken vücudunda %@'den fazla kafein kalan %lld gecede uyku puanın ortalama %@ puan daha düşüktü."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %2$lld من الليالي التي ذهبت فيها إلى النوم وفي جسمك أكثر من %1$@ من الكافيين، كانت درجة نومك أقل بمعدل %3$@ نقطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময় শরীরে %@-এর বেশি ক্যাফেইন থাকা %lld রাতে আপনার ঘুমের স্কোর গড়ে %@ পয়েন্ট কম ছিল।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %2$lld Nächten mit mehr als %1$@ Koffein im Körper beim Zubettgehen lag deine Schlafbewertung im Schnitt %3$@ Punkte niedriger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %2$lld noches que te acostaste con más de %1$@ de cafeína en el cuerpo, tu puntuación de sueño fue de media %3$@ puntos más baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %2$lld nuits où ton corps contenait plus de %1$@ de caféine au coucher, ton score de sommeil était en moyenne inférieur de %3$@ points."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोते समय शरीर में %@ से ज़्यादा कैफ़ीन वाली %lld रातों में आपका नींद स्कोर औसतन %@ अंक कम था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada %2$lld malam saat kamu tidur dengan lebih dari %1$@ kafein di tubuh, skor tidurmu rata-rata %3$@ poin lebih rendah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時に体内のカフェインが%@を超えていた%lld晩は、睡眠スコアが平均%@ポイント低くなりました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas %2$lld noites em que você foi dormir com mais de %1$@ de cafeína no corpo, sua nota de sono foi em média %3$@ pontos menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ночей, когда к отбою в организме было больше %@ кофеина: %lld. В эти ночи оценка сна была в среднем на %@ балла ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前体内咖啡因超过%@的%lld个晚上，你的睡眠评分平均低了%@分。"
          }
        }
      }
    },
    "Yatarken vücudunda hâlâ kafein olacak. Bugün için kafeini burada bırakmak uykuna iyi gelir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There will still be caffeine in your body at bedtime. Stopping caffeine for today will help your sleep."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken vücudunda hâlâ kafein olacak. Bugün için kafeini burada bırakmak uykuna iyi gelir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبقى في جسمك كافيين وقت النوم. التوقف عن الكافيين لهذا اليوم سيفيد نومك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময়ও আপনার শরীরে ক্যাফেইন থাকবে। আজকের মতো ক্যাফেইন এখানেই থামালে ঘুম ভালো হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zubettgehen ist noch Koffein in deinem Körper. Wenn du für heute aufhörst, schläfst du besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al acostarte aún tendrás cafeína en el cuerpo. Dejar la cafeína por hoy le sentará bien a tu sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il restera de la caféine dans ton corps au coucher. Arrêter la caféine pour aujourd'hui sera bénéfique pour ton sommeil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोते समय भी आपके शरीर में कैफ़ीन रहेगा। आज के लिए कैफ़ीन यहीं रोक देना आपकी नींद के लिए अच्छा रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat tidur nanti masih akan ada kafein di tubuhmu. Berhenti minum kafein untuk hari ini akan baik untuk tidurmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時にもまだ体内にカフェインが残ります。今日のカフェインはここまでにすると、睡眠のためになります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na hora de dormir ainda vai ter cafeína no seu corpo. Parar com a cafeína por hoje vai fazer bem para o seu sono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К отбою в организме ещё будет кофеин. Лучше на сегодня закончить с кофеином — так ты будешь лучше спать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到睡觉时你体内仍会有咖啡因。今天的咖啡因就到此为止，对睡眠更好。"
          }
        }
      }
    },
    "Yatarken vücudunda hâlâ kafein olacak; seviyen ancak **%@** civarında uyku eşiğinin altına iner. Bugün için kafeini burada bırakmak uykuna iyi gelir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There will still be caffeine in your body at bedtime; it only drops below the sleep threshold around **%@**. Stopping caffeine for today will help your sleep."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken vücudunda hâlâ kafein olacak; seviyen ancak **%@** civarında uyku eşiğinin altına iner. Bugün için kafeini burada bırakmak uykuna iyi gelir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبقى في جسمك كافيين وقت النوم؛ ولن ينخفض مستواه إلى ما دون عتبة النوم إلا نحو **%@**. التوقف عن الكافيين لهذا اليوم سيفيد نومك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময়ও আপনার শরীরে ক্যাফেইন থাকবে; মাত্রাটি কেবল **%@**-এর দিকে ঘুমের সীমারেখার নিচে নামবে। আজকের মতো ক্যাফেইন এখানেই থামালে ঘুম ভালো হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zubettgehen ist noch Koffein in deinem Körper; der Spiegel fällt erst gegen **%@** unter die Schlafschwelle. Wenn du für heute aufhörst, schläfst du besser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al acostarte aún tendrás cafeína en el cuerpo; tu nivel no bajará del umbral de sueño hasta las **%@** aproximadamente. Dejar la cafeína por hoy le sentará bien a tu sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il restera de la caféine dans ton corps au coucher ; ton taux ne passera sous le seuil de sommeil que vers **%@**. Arrêter la caféine pour aujourd'hui sera bénéfique pour ton sommeil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोते समय भी आपके शरीर में कैफ़ीन रहेगा; इसका स्तर **%@** के आसपास ही नींद की सीमा-रेखा से नीचे आएगा। आज के लिए कैफ़ीन यहीं रोक देना आपकी नींद के लिए अच्छा रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat tidur nanti masih akan ada kafein di tubuhmu; kadarnya baru turun di bawah ambang tidur sekitar **%@**. Berhenti minum kafein untuk hari ini akan baik untuk tidurmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時にもまだ体内にカフェインが残ります。レベルが睡眠のしきい値を下回るのは**%@**ごろです。今日のカフェインはここまでにすると、睡眠のためになります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na hora de dormir ainda vai ter cafeína no seu corpo; o nível só fica abaixo do limiar do sono por volta das **%@**. Parar com a cafeína por hoje vai fazer bem para o seu sono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К отбою в организме ещё будет кофеин; уровень опустится ниже порога сна только около **%@**. Лучше на сегодня закончить с кофеином — так ты будешь лучше спать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到睡觉时你体内仍会有咖啡因；含量要到**%@**左右才会降到睡眠阈值以下。今天的咖啡因就到此为止，对睡眠更好。"
          }
        }
      }
    },
    "Yatarken vücudunda kafein kalan gecelerle kalmayan geceler arasında uyku puanında belirgin bir fark yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no clear difference in your sleep score between nights with and without caffeine at bedtime."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken vücudunda kafein kalan gecelerle kalmayan geceler arasında uyku puanında belirgin bir fark yok."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد فرق واضح في درجة نومك بين الليالي التي يبقى فيها كافيين في جسمك وقت النوم والليالي التي لا يبقى فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময় শরীরে ক্যাফেইন থাকা আর না থাকা রাতগুলোর মধ্যে ঘুমের স্কোরে স্পষ্ট কোনো পার্থক্য নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen Nächten mit und ohne Koffein beim Zubettgehen gibt es keinen deutlichen Unterschied in deiner Schlafbewertung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una diferencia clara en tu puntuación de sueño entre las noches con y sin cafeína al acostarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de différence nette de score de sommeil entre les nuits avec et sans caféine au coucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोते समय शरीर में कैफ़ीन वाली और बिना कैफ़ीन वाली रातों के नींद स्कोर में कोई साफ़ फ़र्क नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada perbedaan jelas pada skor tidurmu antara malam dengan dan tanpa kafein saat tidur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時にカフェインが残っていた夜とそうでない夜で、睡眠スコアにはっきりした差はありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há uma diferença clara na sua nota de sono entre as noites com e sem cafeína na hora de dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Явной разницы в оценке сна между ночами с кофеином к отбою и без него нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前体内有咖啡因和没有咖啡因的晚上，你的睡眠评分没有明显差别。"
          }
        }
      }
    },
    "Yatarken vücudunda kalacak kafein": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeine left at bedtime"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken vücudunda kalacak kafein"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكافيين المتبقي وقت النوم"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময় শরীরে থেকে যাওয়া ক্যাফেইন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Restkoffein beim Zubettgehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafeína que quedará al acostarte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caféine restante au coucher"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोते समय शरीर में बचा कैफ़ीन"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein yang tersisa saat tidur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時に体内に残るカフェイン"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafeína que vai restar na hora de dormir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кофеин, который останется к отбою"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前体内残留的咖啡因"
          }
        }
      }
    },
    "Yatarken vücudunda yaklaşık %lld mg'den fazla kafein kalması derin uykuyu azaltabilir. Caffein, genelde içtiğin miktarda bir içeceği en geç ne zaman içersen yatış saatinde bu eşiğin altında kalacağını hesaplar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going to bed with more than about %lld mg of caffeine in your body can reduce deep sleep. Caffein works out the latest time you can have your usual drink and still be below this at bedtime."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatarken vücudunda yaklaşık %lld mg'den fazla kafein kalması derin uykuyu azaltabilir. Caffein, genelde içtiğin miktarda bir içeceği en geç ne zaman içersen yatış saatinde bu eşiğin altında kalacağını hesaplar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يقلل وجود أكثر من نحو %lld mg من الكافيين في جسمك وقت النوم من النوم العميق. يحسب Caffein آخر وقت يمكنك فيه تناول مشروبك المعتاد مع البقاء دون هذا الحد وقت النوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানোর সময় শরীরে প্রায় %lld mg-এর বেশি ক্যাফেইন থাকলে গভীর ঘুম কমে যেতে পারে। আপনার সাধারণ পানীয়টি সর্বশেষ কখন খেলে ঘুমানোর সময় এর নিচে থাকবেন, Caffein তা হিসাব করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn beim Zubettgehen mehr als etwa %lld mg Koffein in deinem Körper sind, kann das den Tiefschlaf verringern. Caffein berechnet, bis wann du dein übliches Getränk trinken kannst, damit du beim Zubettgehen unter dieser Schwelle bleibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostarte con más de unos %lld mg de cafeína en el cuerpo puede reducir el sueño profundo. Caffein calcula hasta qué hora puedes tomar tu bebida habitual para quedar por debajo de este umbral al acostarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te coucher avec plus d'environ %lld mg de caféine dans le corps peut réduire le sommeil profond. Caffein calcule l'heure limite à laquelle tu peux prendre ta boisson habituelle pour rester sous ce seuil au coucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोते समय शरीर में लगभग %lld mg से ज़्यादा कैफ़ीन होने से गहरी नींद कम हो सकती है। Caffein हिसाब लगाता है कि अपना आम ड्रिंक आप ज़्यादा से ज़्यादा कब तक पी सकते हैं ताकि सोते समय आप इस स्तर से नीचे रहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidur dengan lebih dari sekitar %lld mg kafein di tubuh bisa mengurangi tidur nyenyak. Caffein menghitung kapan paling lambat kamu bisa minum minuman biasamu agar kadarnya tetap di bawah ambang ini saat tidur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時に体内のカフェインが約%lld mgを超えていると、深い眠りが減ることがあります。Caffeinは、いつもの量の飲み物を何時までに飲めば就寝時にこのしきい値を下回るかを計算します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir dormir com mais de cerca de %lld mg de cafeína no corpo pode reduzir o sono profundo. O Caffein calcula até que horas você pode tomar sua bebida de sempre e ainda ficar abaixo desse limiar na hora de dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если к отбою в организме больше примерно %lld mg кофеина, глубокого сна может стать меньше. Caffein рассчитывает, до какого времени можно выпить привычный напиток, чтобы к отбою остаться ниже этого порога."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前体内咖啡因超过约%lld mg可能会减少深度睡眠。Caffein 会计算你最晚什么时候喝下平常的一杯，到就寝时仍能低于这个阈值。"
          }
        }
      }
    },
