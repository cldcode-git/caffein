    "Nasıl uyudun?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How did you sleep?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl uyudun?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف كان نومك؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুম কেমন হলো?"
          }
        },
        "de": {
