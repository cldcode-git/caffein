    "Geç kafein uykunu etkiliyor olabilir": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late caffeine may be affecting your sleep"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geç kafein uykunu etkiliyor olabilir"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون الكافيين المتأخر مؤثرًا في نومك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেরিতে নেওয়া ক্যাফেইন হয়তো আপনার ঘুমে প্রভাব ফেলছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätes Koffein stört vielleicht deinen Schlaf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cafeína tardía podría estar afectando a tu sueño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caféine tardive pourrait perturber ton sommeil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देर से लिया कैफ़ीन शायद आपकी नींद पर असर डाल रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein yang terlambat mungkin memengaruhi tidurmu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅い時間のカフェインが睡眠に影響しているかもしれません"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cafeína tarde pode estar afetando seu sono"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поздний кофеин может влиять на твой сон"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚间咖啡因可能在影响你的睡眠"
          }
        }
      }
    },
    "Geç kafein uykunu kısaltıyor olabilir": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late caffeine may be shortening your sleep"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geç kafein uykunu kısaltıyor olabilir"
