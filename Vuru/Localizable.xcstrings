    "Bu seçimle bugünkü son kahve saatin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last coffee today with this choice"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seçimle bugünkü son kahve saatin"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر موعد لقهوتك اليوم بهذا الاختيار"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বাছাইয়ে আজ আপনার শেষ কফির সময়"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein letzter Kaffee heute mit dieser Wahl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta elección, tu último café de hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ce choix, ton dernier café aujourd'hui"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चुनाव के साथ आज आपकी आखिरी कॉफ़ी का समय"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu kopi terakhirmu hari ini dengan pilihan ini"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この選択での今日の最後のコーヒー時刻"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com essa escolha, seu último café de hoje"
          }
        },
        "ru": {
          "stringUnit": {
