    "Aç karnına içtiysen hafif bir şeyler ye.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you drank on an empty stomach, have a light snack."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aç karnına içtiysen hafif bir şeyler ye."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا شربت على معدة فارغة، فتناول وجبة خفيفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খালি পেটে পান করে থাকলে হালকা কিছু খেয়ে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du auf leeren Magen getrunken hast, iss eine Kleinigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo tomaste en ayunas, come algo ligero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as bu à jeun, mange un petit quelque chose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर खाली पेट पिया है, तो कुछ हल्का खा लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau kamu minum saat perut kosong, makanlah camilan ringan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空腹で飲んだなら、軽く何か食べましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você bebeu de estômago vazio, coma algo leve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если пьёшь натощак, съешь что-нибудь лёгкое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你是空腹喝的，吃点清淡的东西。"
          }
        }
      }
    },
