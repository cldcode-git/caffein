            "value": "Vibrer à chaque battement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर धड़कन पर वाइब्रेशन"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Getar di setiap detak"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
