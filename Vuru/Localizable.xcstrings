    "Kayıtlı gecelerin hiçbirinde yatarken vücudunda belirgin kafein kalmadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On none of the logged nights did you go to bed with noticeable caffeine in your body."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı gecelerin hiçbirinde yatarken vücudunda belirgin kafein kalmadı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكن في جسمك كافيين يُذكر وقت النوم في أيٍّ من الليالي المسجّلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড করা কোনো রাতেই ঘুমাতে যাওয়ার সময় আপনার শরীরে উল্লেখযোগ্য ক্যাফেইন ছিল না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In keiner der erfassten Nächte war beim Zubettgehen noch nennenswert Koffein in deinem Körper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ninguna de las noches registradas te acostaste con una cantidad notable de cafeína en el cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur aucune des nuits enregistrées, il ne restait de quantité notable de caféine dans ton corps au coucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज की गई किसी भी रात सोते समय आपके शरीर में उल्लेखनीय कैफ़ीन नहीं था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada satu pun malam tercatat saat kamu tidur dengan kafein yang masih terasa di tubuhmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録したどの夜も、体内にカフェインがはっきり残った状態で寝てはいませんでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em nenhuma das noites registradas você foi dormir com uma quantidade relevante de cafeína no corpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни в одну из записанных ночей к отбою в организме не оставалось заметного количества кофеина."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有已记录的晚上，你上床时体内都没有明显残留的咖啡因。"
          }
        }
      }
    },
    "Kaçta uyandın?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did you wake up?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaçta uyandın?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى استيقظت؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কটায় ঘুম থেকে উঠলেন?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann bist du aufgewacht?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué hora te despertaste?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure de réveil ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कितने बजे उठे?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bangun jam berapa?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何時に起きましたか？"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que horas você acordou?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во сколько был подъём?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你几点醒的？"
          }
        }
      }
    },
    "Kaçta yattın?": {
      "localizations": {
        "en": {
          "stringUnit": {
