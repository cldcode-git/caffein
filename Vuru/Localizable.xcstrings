    "Sabah ölçümü ve akşam puanıyla burada günlük gerginlik göstergen oluşacak.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With morning measurements and evening ratings, your daily tension indicator will appear here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah ölçümü ve akşam puanıyla burada günlük gerginlik göstergen oluşacak."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع قياسات الصباح وتقييمات المساء، سيظهر هنا مؤشر توترك اليومي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সকালের মাপ আর সন্ধ্যার রেটিং দিয়ে এখানে আপনার দৈনিক টেনশন সূচক তৈরি হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Morgenmessungen und Abendbewertungen erscheint hier deine tägliche Anspannungsanzeige."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con las mediciones matutinas y las puntuaciones de la noche, aquí aparecerá tu indicador diario de tensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec les mesures du matin et les notes du soir, ton indicateur de tension quotidien apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह के माप और शाम की रेटिंग से आपका दैनिक तनाव संकेतक यहाँ दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan pengukuran pagi dan nilai malam, indikator ketegangan harianmu akan muncul di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝の測定と夜の評価がそろうと、ここに毎日の緊張インジケーターが表示されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com as medições da manhã e as notas da noite, seu indicador diário de tensão vai aparecer aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С утренними замерами и вечерними оценками здесь появится твой дневной индикатор напряжения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有了晨间测量和晚间评分后，你的每日紧张指标会显示在这里。"
          }
        }
      }
    },
