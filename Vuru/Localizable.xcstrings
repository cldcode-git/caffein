    "Günlük kafein sınırın yaşına ve kilona göre hesaplanır. Bu bilgiler yalnızca bu telefonda kalır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your daily caffeine limit is based on your age and weight. This information stays on this phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük kafein sınırın yaşına ve kilona göre hesaplanır. Bu bilgiler yalnızca bu telefonda kalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب حدّك اليومي من الكافيين حسب عمرك ووزنك. تبقى هذه المعلومات على هذا الهاتف فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দৈনিক ক্যাফেইন সীমা আপনার বয়স আর ওজনের ভিত্তিতে ঠিক হয়। এই তথ্য শুধু এই ফোনেই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Koffein-Tageslimit richtet sich nach Alter und Gewicht. Diese Angaben bleiben nur auf diesem Handy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu límite diario de cafeína se calcula según tu edad y peso. Estos datos se quedan solo en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta limite quotidienne de caféine dépend de ton âge et de ton poids. Ces informations restent uniquement sur ce téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी दैनिक कैफ़ीन सीमा आपकी उम्र और वज़न के आधार पर तय होती है। यह जानकारी सिर्फ़ इसी फ़ोन पर रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas kafein harianmu dihitung berdasarkan usia dan berat badan. Informasi ini hanya disimpan di ponsel ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日のカフェイン上限は年齢と体重から計算します。この情報はこのiPhoneの中だけに保存されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu limite diário de cafeína é calculado pela sua idade e peso. Esses dados ficam só neste celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневной лимит кофеина рассчитывается по возрасту и весу. Эти данные остаются только на этом телефоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的每日咖啡因上限根据年龄和体重计算。这些信息只保存在这部手机上。"
          }
        }
      }
    },
