    "Sakin, kısa bir yürüyüş titremeyi azaltabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short, easy walk can ease the jitters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin, kısa bir yürüyüş titremeyi azaltabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يخفف مشيٌ قصير وهادئ من الرعشة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধীরে একটু হাঁটলে কাঁপুনি কমতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer, ruhiger Spaziergang kann das Zittern lindern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paseo corto y tranquilo puede aliviar los temblores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courte marche tranquille peut atténuer les tremblements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम से थोड़ी देर टहलने से कँपकँपी कम हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalan santai sebentar bisa mengurangi gemetar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆったり短い散歩をすると、手の震えがやわらぐことがあります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma caminhada curta e tranquila pode diminuir os tremores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойная короткая прогулка может уменьшить дрожь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平静地散散步可以减轻发抖。"
          }
        }
      }
    },
