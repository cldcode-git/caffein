    "Uykun geç kafeine dayanıklı görünüyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sleep seems resilient to late caffeine"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uykun geç kafeine dayanıklı görünüyor"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن نومك لا يتأثر كثيرًا بالكافيين المتأخر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেরির ক্যাফেইনেও আপনার ঘুম ঠিক থাকে বলে মনে হচ্ছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlaf scheint spätes Koffein gut wegzustecken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sueño parece resistir bien la cafeína tardía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton sommeil semble bien résister à la caféine tardive"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगता है देर का कैफ़ीन आपकी नींद पर ख़ास असर नहीं डालता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidurmu tampaknya tahan terhadap kafein yang terlambat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの睡眠は遅い時間のカフェインに強いようです"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu sono parece resistente à cafeína tarde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, твой сон устойчив к позднему кофеину"
          }
        },
