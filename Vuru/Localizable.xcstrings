    "Nabzın %lld BPM olarak kaydedilecek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your heart rate will be saved as %lld BPM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabzın %lld BPM olarak kaydedilecek."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحفظ نبضك على أنه %lld BPM."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হার্ট রেট %lld BPM হিসেবে সেভ হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Puls wird als %lld BPM gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso se guardará como %lld BPM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls sera enregistré à %lld BPM."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी धड़कन %lld BPM के रूप में सेव होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantungmu akan disimpan sebagai %lld BPM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数は%lld BPMとして記録されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frequência cardíaca será salva como %lld BPM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой пульс будет сохранён как %lld BPM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心率将记录为%lld BPM。"
          }
        }
      }
    },
    "Nabzın %lld atım yavaşladı. Yavaş nefes, sinir sistemini sakinleştirmenin en hızlı yollarından biri.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your heart rate slowed by %lld bpm. Slow breathing is one of the quickest ways to calm your nervous system."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabzın %lld atım yavaşladı. Yavaş nefes, sinir sistemini sakinleştirmenin en hızlı yollarından biri."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تباطأ نبضك بمقدار %lld نبضة. التنفس البطيء من أسرع الطرق لتهدئة جهازك العصبي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হার্ট রেট %lld বিট কমেছে। ধীরে শ্বাস নেওয়া স্নায়ুতন্ত্রকে শান্ত করার সবচেয়ে দ্রুত উপায়গুলোর একটি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Puls ist um %lld Schläge gesunken. Langsames Atmen ist einer der schnellsten Wege, dein Nervensystem zu beruhigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso bajó %lld lpm. Respirar despacio es una de las formas más rápidas de calmar el sistema nervioso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls a ralenti de %lld bpm. Respirer lentement est l'un des moyens les plus rapides de calmer ton système nerveux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी धड़कन %lld बीट धीमी हुई। धीमी साँस तंत्रिका तंत्र को शांत करने के सबसे तेज़ तरीकों में से एक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantungmu melambat %lld bpm. Bernapas pelan adalah salah satu cara tercepat untuk menenangkan sistem sarafmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数が%lld bpm下がりました。ゆっくりした呼吸は、神経を落ち着かせるいちばん速い方法のひとつです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frequência cardíaca caiu %lld bpm. Respirar devagar é uma das formas mais rápidas de acalmar o sistema nervoso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс замедлился на %lld уд./мин. Медленное дыхание — один из самых быстрых способов успокоить нервную систему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心率降低了%lld次/分。慢呼吸是让神经系统平静下来最快的方法之一。"
          }
        }
      }
    },
    "Nabzın %lld atım yükseldi. Bazen ölçüm anı da heyecan yaratır; birkaç dakika sonra tekrar deneyebilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your heart rate rose by %lld bpm. Measuring itself can be exciting; you can try again in a few minutes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabzın %lld atım yükseldi. Bazen ölçüm anı da heyecan yaratır; birkaç dakika sonra tekrar deneyebilirsin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفع نبضك بمقدار %lld نبضة. أحيانًا تُثير لحظة القياس نفسها بعض الانفعال؛ يمكنك المحاولة مجددًا بعد بضع دقائق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হার্ট রেট %lld বিট বেড়েছে। মাপার মুহূর্তটাও অনেক সময় উত্তেজনা তৈরি করে; কয়েক মিনিট পর আবার চেষ্টা করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Puls ist um %lld Schläge gestiegen. Manchmal sorgt schon das Messen für Aufregung; du kannst es in ein paar Minuten noch mal versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso subió %lld lpm. A veces el propio momento de medir pone nervioso; puedes volver a intentarlo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls a augmenté de %lld bpm. Le moment de la mesure peut lui-même être stressant ; tu peux réessayer dans quelques minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी धड़कन %lld बीट बढ़ गई। कभी-कभी मापने का पल भी उत्तेजना पैदा करता है; कुछ मिनट बाद फिर कोशिश कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantungmu naik %lld bpm. Kadang saat mengukur pun bisa bikin deg-degan; kamu bisa coba lagi beberapa menit lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数が%lld bpm上がりました。測定すること自体で緊張することもあります。数分後にもう一度試してみてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frequência cardíaca subiu %lld bpm. Às vezes o próprio momento da medição deixa a gente agitado; você pode tentar de novo em alguns minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс вырос на %lld уд./мин. Иногда сам замер вызывает волнение; можно попробовать снова через несколько минут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心率升高了%lld次/分。有时测量本身也会让人紧张；你可以几分钟后再试一次。"
          }
        }
      }
    },
    "Nabzın hemen hemen aynı kaldı. Hissettiğin rahatlama da önemli; sayı her zaman değişmeyebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your heart rate stayed about the same. How relaxed you feel matters too; the number doesn't always change."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabzın hemen hemen aynı kaldı. Hissettiğin rahatlama da önemli; sayı her zaman değişmeyebilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقي نبضك تقريبًا كما هو. شعورك بالاسترخاء مهم أيضًا؛ فالرقم لا يتغير دائمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হার্ট রেট প্রায় একই আছে। আপনি যে স্বস্তি অনুভব করছেন সেটাও গুরুত্বপূর্ণ; সংখ্যা সবসময় বদলায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Puls ist fast gleich geblieben. Wie entspannt du dich fühlst, zählt auch; die Zahl ändert sich nicht immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso se mantuvo casi igual. La calma que sientes también importa; el número no siempre cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls est resté à peu près le même. La détente que tu ressens compte aussi ; le chiffre ne change pas toujours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी धड़कन लगभग वैसी ही रही। आप जो राहत महसूस करते हैं, वह भी मायने रखती है; संख्या हमेशा नहीं बदलती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantungmu hampir tidak berubah. Rasa rileks yang kamu rasakan juga penting; angkanya tidak selalu berubah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数はほとんど変わりませんでした。感じたリラックスも大切です。数値がいつも変わるとは限りません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frequência cardíaca ficou praticamente igual. O alívio que você sente também importa; o número nem sempre muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс почти не изменился. Важно и то, насколько спокойнее ты себя чувствуешь; число меняется не всегда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心率基本没变。你感受到的放松同样重要；数字不一定每次都会变化。"
          }
        }
      }
    },
    "Nabzını parmak ucundaki renk değişiminden okuyoruz. Görüntü kaydedilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We read your heart rate from the colour change in your fingertip. No image is saved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabzını parmak ucundaki renk değişiminden okuyoruz. Görüntü kaydedilmez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقرأ نبضك من تغيّر اللون في طرف إصبعك. لا تُحفظ أي صورة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আঙুলের ডগার রঙের পরিবর্তন থেকে আমরা আপনার হার্ট রেট পড়ি। কোনো ছবি সেভ হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir lesen deinen Puls an der Farbänderung deiner Fingerkuppe ab. Es wird kein Bild gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leemos tu pulso a partir del cambio de color en la yema de tu dedo. No se guarda ninguna imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous lisons ton pouls grâce au changement de couleur du bout de ton doigt. Aucune image n'est enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपकी धड़कन उंगली के सिरे के रंग में बदलाव से पढ़ते हैं। कोई तस्वीर सेव नहीं होती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami membaca detak jantungmu dari perubahan warna di ujung jarimu. Gambar tidak disimpan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指先の色の変化から心拍数を読み取ります。映像は保存されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemos sua frequência cardíaca pela mudança de cor na ponta do seu dedo. Nenhuma imagem é gravada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы считываем пульс по изменению цвета кончика пальца. Изображение не сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们通过指尖的颜色变化读取你的心率。不会保存任何画面。"
          }
        }
      }
    },
    "Nabzını ölç, 2 dakika birlikte nefes alalım, sonra tekrar ölç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure your heart rate, breathe with us for 2 minutes, then measure again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabzını ölç, 2 dakika birlikte nefes alalım, sonra tekrar ölç."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِس نبضك، وتنفّس معنا لمدة دقيقتين، ثم قِسه مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হার্ট রেট মাপুন, আমাদের সাথে 2 মিনিট শ্বাস নিন, তারপর আবার মাপুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss deinen Puls, atme 2 Minuten mit uns und miss dann noch mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide tu pulso, respira con nosotros durante 2 minutos y vuelve a medir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure ton pouls, respire avec nous pendant 2 minutes, puis mesure à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी धड़कन मापें, 2 मिनट हमारे साथ साँस लें, फिर दोबारा मापें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur detak jantungmu, bernapas bersama kami selama 2 menit, lalu ukur lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍数を測って、2分間いっしょに呼吸して、もう一度測りましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça sua frequência cardíaca, respire com a gente por 2 minutos e meça de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерь пульс, подыши с нами 2 минуты, затем измерь снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测一下心率，跟我们一起呼吸2分钟，然后再测一次。"
          }
        }
      }
    },
