    "Yaşını ve kilonu gir, sınırı sana göre hesaplayalım": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your age and weight for a personal limit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşını ve kilonu gir, sınırı sana göre hesaplayalım"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عمرك ووزنك لنحسب حدًّا خاصًا بك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বয়স আর ওজন দিন, আপনার নিজস্ব সীমা হিসাব করে দেব"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Alter und Gewicht ein für dein persönliches Limit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu edad y peso para calcular tu límite personal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique ton âge et ton poids pour une limite personnalisée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी उम्र और वज़न डालें, हम आपकी निजी सीमा निकालेंगे"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan usia dan berat badanmu untuk batas pribadi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年齢と体重を入力すると、あなたに合った上限を計算します"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe sua idade e peso para um limite personalizado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажи возраст и вес — рассчитаем лимит для тебя"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入年龄和体重，为你计算专属上限"
          }
        }
      }
    },
    "Yaşını ve kilonu girene kadar sağlıklı yetişkinler için genel referans olan 400 mg kullanılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you enter your age and weight, the general 400 mg reference for healthy adults is used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşını ve kilonu girene kadar sağlıklı yetişkinler için genel referans olan 400 mg kullanılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أن تُدخل عمرك ووزنك، تُستخدم القيمة المرجعية العامة للبالغين الأصحاء وهي 400 mg."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বয়স আর ওজন না দেওয়া পর্যন্ত সুস্থ প্রাপ্তবয়স্কদের জন্য সাধারণ রেফারেন্স 400 mg ব্যবহার করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis du Alter und Gewicht eingibst, gilt der allgemeine Richtwert von 400 mg für gesunde Erwachsene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que introduzcas tu edad y peso, se usa la referencia general de 400 mg para adultos sanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que tu n'as pas indiqué ton âge et ton poids, la référence générale de 400 mg pour les adultes en bonne santé est utilisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप उम्र और वज़न नहीं डालते, स्वस्थ वयस्कों के लिए सामान्य संदर्भ 400 mg इस्तेमाल होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampai kamu memasukkan usia dan berat badan, digunakan acuan umum 400 mg untuk orang dewasa yang sehat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年齢と体重を入力するまでは、健康な成人向けの一般的な目安である400 mgを使います。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até você informar sua idade e peso, usamos a referência geral de 400 mg para adultos saudáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ты не укажешь возраст и вес, используется общий ориентир для здоровых взрослых — 400 mg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你输入年龄和体重之前，将使用适用于健康成人的一般参考值400 mg。"
          }
        }
      }
    },
    "Yetişkinler için kilo başına yaklaşık 5,7 mg: EFSA'nın 70 kg'lık bir yetişkin için önerdiği 400 mg'nin kilona göre karşılığı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 5.7 mg per kg for adults: EFSA's 400 mg for a 70 kg adult, scaled to your weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetişkinler için kilo başına yaklaşık 5,7 mg: EFSA'nın 70 kg'lık bir yetişkin için önerdiği 400 mg'nin kilona göre karşılığı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو 5.7 mg لكل kg للبالغين: قيمة EFSA البالغة 400 mg لشخص بالغ وزنه 70 kg، معدّلة حسب وزنك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাপ্তবয়স্কদের জন্য প্রতি kg-তে প্রায় 5.7 mg: 70 kg ওজনের প্রাপ্তবয়স্কের জন্য EFSA-র 400 mg, আপনার ওজন অনুযায়ী হিসাব করা।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 5,7 mg pro kg für Erwachsene: die 400 mg, die die EFSA für Erwachsene mit 70 kg nennt, umgerechnet auf dein Gewicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos 5,7 mg por kg para adultos: los 400 mg que la EFSA indica para un adulto de 70 kg, ajustados a tu peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ 5,7 mg par kg pour les adultes : les 400 mg recommandés par l'EFSA pour un adulte de 70 kg, ramenés à ton poids."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वयस्कों के लिए लगभग 5.7 mg प्रति kg: 70 kg के वयस्क के लिए EFSA के 400 mg को आपके वज़न के अनुसार बदला गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekitar 5,7 mg per kg untuk orang dewasa: 400 mg dari EFSA untuk orang dewasa 70 kg, disesuaikan dengan berat badanmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成人は体重1 kgあたり約5.7 mg：EFSAが体重70 kgの成人に推奨する400 mgを、あなたの体重に換算した値です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de 5,7 mg por kg para adultos: os 400 mg que a EFSA indica para um adulto de 70 kg, ajustados ao seu peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для взрослых — около 5,7 mg на 1 kg веса: это 400 mg, которые EFSA указывает для взрослого весом 70 kg, пересчитанные на твой вес."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成人约每公斤体重5.7 mg：即 EFSA 为70 kg成人建议的400 mg按你的体重换算。"
          }
        }
      }
    },
    "Yetişkinler için önerilen üst sınır olan 400 mg. Kilo arttıkça bu sınır yükselmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recommended upper limit of 400 mg for adults. It doesn't go higher with more weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetişkinler için önerilen üst sınır olan 400 mg. Kilo arttıkça bu sınır yükselmez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأعلى الموصى به للبالغين وهو 400 mg. ولا يرتفع هذا الحد مع زيادة الوزن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাপ্তবয়স্কদের জন্য প্রস্তাবিত ঊর্ধ্বসীমা 400 mg। ওজন বেশি হলেও এই সীমা বাড়ে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die empfohlene Obergrenze von 400 mg für Erwachsene. Sie steigt bei höherem Gewicht nicht weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite máximo recomendado de 400 mg para adultos. No aumenta con más peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite maximale recommandée de 400 mg pour les adultes. Elle n'augmente pas avec le poids."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वयस्कों के लिए सुझाई गई ऊपरी सीमा 400 mg। वज़न ज़्यादा होने पर यह सीमा नहीं बढ़ती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas atas yang dianjurkan untuk orang dewasa, yaitu 400 mg. Batas ini tidak naik meski berat badan bertambah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成人に推奨される上限の400 mg。体重が増えてもこの上限は上がりません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite máximo recomendado de 400 mg para adultos. Ele não aumenta com mais peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуемый верхний предел для взрослых — 400 mg. С ростом веса этот лимит не увеличивается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成人建议上限为400 mg。体重增加，这个上限也不会提高。"
          }
        }
      }
    },
