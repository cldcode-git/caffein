    "Bu cihazda arka kamera bulunamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No back camera was found on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda arka kamera bulunamadı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على كاميرا خلفية في هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে পেছনের ক্যামেরা পাওয়া যায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät wurde keine Rückkamera gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una cámara trasera en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil photo arrière n'a été trouvé sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर पीछे का कैमरा नहीं मिला।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera belakang tidak ditemukan di perangkat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに背面カメラが見つかりません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma câmera traseira foi encontrada neste aparelho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве не найдена задняя камера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上未找到后置摄像头。"
          }
        }
      }
    },
