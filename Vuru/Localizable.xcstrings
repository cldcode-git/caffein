    "Silmek için kayda basılı tut.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold an entry to delete it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silmek için kayda basılı tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس أي إدخال مطولًا لحذفه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছতে কোনো এন্ট্রিতে চেপে ধরে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Eintrag gedrückt, um ihn zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un registro para eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens le doigt sur une entrée pour la supprimer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिलीट करने के लिए किसी एंट्री को दबाकर रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh dan tahan catatan untuk menghapusnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を長押しすると削除できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um registro para apagá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы удалить запись, нажми и удерживай её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一条记录即可删除。"
          }
        }
      }
    },
    "Sinyal aranıyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for a signal"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyal aranıyor"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ البحث عن إشارة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিগন্যাল খোঁজা হচ্ছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal wird gesucht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando señal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche du signal"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिग्नल खोजा जा रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari sinyal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信号を探しています"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurando sinal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск сигнала"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在寻找信号"
          }
        }
      }
    },
    "Sinyal net değildi, tekrar ölçüyoruz. Parmağını bastırmadan, sabit tut.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signal wasn't clear, measuring again. Keep your finger still without pressing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyal net değildi, tekrar ölçüyoruz. Parmağını bastırmadan, sabit tut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكن الإشارة واضحة، نعيد القياس. أبقِ إصبعك ثابتًا دون أن تضغط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিগন্যাল পরিষ্কার ছিল না, আবার মাপা হচ্ছে। আঙুল না চেপে স্থির রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Signal war nicht klar, wir messen erneut. Halte den Finger ruhig, ohne zu drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La señal no era clara, volvemos a medir. Mantén el dedo quieto sin apretar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal n'était pas net, nouvelle mesure en cours. Garde ton doigt immobile sans appuyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिग्नल साफ़ नहीं था, दोबारा माप रहे हैं। उंगली बिना दबाए स्थिर रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyalnya tidak jelas, kami ukur lagi. Tahan jarimu tetap diam tanpa menekan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信号がはっきりしなかったので、もう一度測ります。指を押しつけず、動かさないでください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O sinal não ficou claro, vamos medir de novo. Mantenha o dedo parado, sem apertar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал был нечётким, измеряем снова. Держи палец неподвижно, не надавливая."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信号不清晰，正在重新测量。保持手指不动，不要用力按压。"
          }
        }
      }
    },
    "Sinyal tam net değildi; sonuç birkaç atım sapabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signal wasn't perfectly clear; the result may be off by a few beats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyal tam net değildi; sonuç birkaç atım sapabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكن الإشارة واضحة تمامًا؛ قد تنحرف النتيجة ببضع نبضات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিগন্যাল পুরোপুরি পরিষ্কার ছিল না; ফলাফল কয়েক বিট এদিক-ওদিক হতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Signal war nicht ganz klar; das Ergebnis kann um ein paar Schläge abweichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La señal no era del todo clara; el resultado puede variar unos latidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal n'était pas tout à fait net ; le résultat peut varier de quelques battements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिग्नल पूरी तरह साफ़ नहीं था; नतीजे में कुछ बीट का फ़र्क हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyalnya kurang jelas; hasilnya bisa meleset beberapa denyut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信号が完全にはっきりしていませんでした。結果が数拍ずれている可能性があります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O sinal não ficou totalmente claro; o resultado pode variar alguns batimentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал был не совсем чётким; результат может отличаться на несколько ударов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信号不够清晰；结果可能有几次的偏差。"
          }
        }
      }
    },
    "Sinyal zayıf olduğu için sayı göstermiyoruz. Elini ısıtıp, parmağını bastırmadan tekrar dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signal was too weak to show a number. Warm your hand and try again without pressing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyal zayıf olduğu için sayı göstermiyoruz. Elini ısıtıp, parmağını bastırmadan tekrar dene."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشارة أضعف من أن نعرض رقمًا. دفّئ يدك وحاول مجددًا دون أن تضغط بإصبعك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিগন্যাল খুব দুর্বল ছিল, তাই কোনো সংখ্যা দেখানো হচ্ছে না। হাত গরম করে, আঙুল না চেপে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Signal war zu schwach, daher zeigen wir keine Zahl. Wärm deine Hand und versuch es noch mal, ohne zu drücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La señal era demasiado débil para mostrar un número. Calienta la mano e inténtalo de nuevo sin apretar el dedo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal était trop faible pour afficher un chiffre. Réchauffe ta main et réessaie sans appuyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिग्नल बहुत कमज़ोर था, इसलिए कोई संख्या नहीं दिखा रहे। हाथ गर्म करें और बिना दबाए फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyal terlalu lemah untuk menampilkan angka. Hangatkan tanganmu dan coba lagi tanpa menekan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信号が弱いため、数値は表示しません。手を温めて、指を押しつけずにもう一度試してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O sinal estava fraco demais para mostrar um número. Aqueça a mão e tente de novo sem apertar o dedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал слишком слабый, поэтому число не показываем. Согрей руку и попробуй снова, не надавливая пальцем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信号太弱，无法显示数字。暖暖手，再不用力按压地试一次。"
          }
        }
      }
    },
