    "Çarpıntı ve yüksek nabız için öneriler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips for palpitations and a high heart rate"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çarpıntı ve yüksek nabız için öneriler"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصائح للخفقان وارتفاع النبض"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বুক ধড়ফড় আর দ্রুত হার্ট রেটের জন্য পরামর্শ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipps bei Herzklopfen und hohem Puls"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejos para las palpitaciones y el pulso alto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseils en cas de palpitations et de pouls élevé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिल की धड़कन तेज़ महसूस होने और हाई हार्ट रेट के लिए सुझाव"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips untuk jantung berdebar dan detak jantung tinggi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動悸や心拍数が高いときのヒント"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicas para palpitações e frequência cardíaca alta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Советы при сильном сердцебиении и высоком пульсе"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心悸和心率过快时的建议"
          }
        }
      }
    },
    "Çarpıntı, titreme ya da huzursuzluk hissediyorsan neler yapabileceğine bak.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you feel palpitations, jitters or restlessness, see what you can do."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çarpıntı, titreme ya da huzursuzluk hissediyorsan neler yapabileceğine bak."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا شعرت بخفقان أو رعشة أو تململ، فاطّلع على ما يمكنك فعله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বুক ধড়ফড়, কাঁপুনি বা অস্থিরতা লাগলে কী করতে পারেন দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Herzklopfen, Zittern oder Unruhe spürst, schau, was du tun kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si notas palpitaciones, temblores o inquietud, mira qué puedes hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ressens des palpitations, des tremblements ou de l'agitation, découvre ce que tu peux faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर दिल की धड़कन तेज़ महसूस हो, कँपकँपी या बेचैनी हो, तो देखें कि आप क्या कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau kamu merasa berdebar, gemetar, atau gelisah, lihat apa yang bisa kamu lakukan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動悸、手の震え、そわそわ感があるときにできることを確認しましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você sentir palpitações, tremores ou inquietação, veja o que pode fazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если чувствуешь сильное сердцебиение, дрожь или беспокойство, посмотри, что можно сделать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你感到心悸、发抖或烦躁不安，看看可以怎么做。"
          }
        }
      }
    },
    "Çarpıntıya şunlardan biri eşlik ediyorsa beklemeden acil yardım hattını (%@) ara:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If palpitations come with any of these, call emergency services (%@) right away:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çarpıntıya şunlardan biri eşlik ediyorsa beklemeden acil yardım hattını (%@) ara:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا صاحب الخفقانَ أيٌّ مما يلي، فاتصل برقم الطوارئ (%@) فورًا:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বুক ধড়ফড়ের সাথে এর কোনোটি থাকলে দেরি না করে জরুরি নম্বরে (%@) কল করুন:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn zum Herzklopfen eines dieser Anzeichen dazukommt, ruf sofort den Notruf (%@) an:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si las palpitaciones vienen con alguno de estos síntomas, llama sin esperar a emergencias (%@):"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les palpitations s'accompagnent de l'un de ces signes, appelle immédiatement les urgences (%@) :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर तेज़ धड़कन के साथ इनमें से कुछ भी हो, तो बिना देर किए आपातकालीन नंबर (%@) पर कॉल करें:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau jantung berdebar disertai salah satu dari gejala berikut, segera hubungi layanan darurat (%@):"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動悸とともに次のいずれかがある場合は、ためらわずに救急（%@）に電話してください："
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se as palpitações vierem acompanhadas de qualquer um destes sinais, ligue na hora para a emergência (%@):"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сердцебиение сопровождается чем-то из этого, сразу звони в экстренную службу (%@):"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果心悸同时伴有以下任何一种情况，请立即拨打急救电话（%@）："
          }
        }
      }
    },
    "Çarpıntıyı sık yaşıyorsan ya da kafein azken de oluyorsa bir doktora danış.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you get palpitations often, or even with little caffeine, see a doctor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çarpıntıyı sık yaşıyorsan ya da kafein azken de oluyorsa bir doktora danış."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تشعر بالخفقان كثيرًا، أو حتى مع القليل من الكافيين، فراجع طبيبًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রায়ই বুক ধড়ফড় করলে, বা কম ক্যাফেইনেও হলে, ডাক্তার দেখান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du oft Herzklopfen hast oder es auch bei wenig Koffein auftritt, geh zum Arzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes palpitaciones a menudo, o incluso con poca cafeína, consulta a un médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as souvent des palpitations, ou même avec peu de caféine, consulte un médecin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपको अक्सर धड़कन तेज़ महसूस होती है, या कम कैफ़ीन पर भी होती है, तो डॉक्टर को दिखाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau kamu sering mengalami jantung berdebar, atau tetap berdebar meski kafeinnya sedikit, periksakan ke dokter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動悸がよく起こる場合や、カフェインが少なくても起こる場合は、医師に相談してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você tem palpitações com frequência, ou mesmo com pouca cafeína, procure um médico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сильное сердцебиение бывает часто или даже при небольшом количестве кофеина, обратись к врачу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你经常心悸，或者在咖啡因摄入很少时也会心悸，请咨询医生。"
          }
        }
      }
    },
