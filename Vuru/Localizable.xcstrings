    "İki dakikalık nefes tamamlandı. Kendine bu molayı verdiğin için iyi yaptın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two minutes of breathing done. Good on you for taking this break."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki dakikalık nefes tamamlandı. Kendine bu molayı verdiğin için iyi yaptın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل تمرين التنفس لمدة دقيقتين. أحسنت بمنح نفسك هذه الاستراحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুই মিনিটের শ্বাসের ব্যায়াম শেষ। নিজেকে এই বিরতিটুকু দিয়ে ভালো করেছেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Minuten Atmen geschafft. Schön, dass du dir diese Pause gegönnt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos minutos de respiración completados. Bien hecho por regalarte esta pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux minutes de respiration terminées. Bravo de t'être accordé cette pause."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो मिनट का साँस का अभ्यास पूरा हुआ। खुद को यह ब्रेक देकर आपने अच्छा किया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua menit bernapas selesai. Bagus sekali kamu meluangkan waktu untuk jeda ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2分間の呼吸が終わりました。自分にひと息つく時間をあげられましたね。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois minutos de respiração concluídos. Que bom que você se deu essa pausa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две минуты дыхания позади. Хорошо, что ты позволяешь себе такую паузу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2分钟呼吸完成。给自己这样一个休息，做得很好。"
          }
        }
      }
    },
