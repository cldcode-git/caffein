    "Değerler bir porsiyon için yaklaşıktır; demleme süresi, fincan boyu ve markaya göre değişir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are approximate per serving and vary with brewing time, cup size and brand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerler bir porsiyon için yaklaşıktır; demleme süresi, fincan boyu ve markaya göre değişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيم تقريبية لكل حصة، وتختلف حسب مدة التحضير وحجم الكوب والعلامة التجارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানগুলো প্রতি সার্ভিংয়ের আনুমানিক হিসাব; বানানোর সময়, কাপের মাপ আর ব্র্যান্ডভেদে বদলায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werte gelten ungefähr pro Portion und hängen von Ziehzeit, Tassengröße und Marke ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores son aproximados por ración y varían según el tiempo de preparación, el tamaño de la taza y la marca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sont approximatives par portion et varient selon le temps d'infusion, la taille de la tasse et la marque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मान एक सर्विंग के लिए अनुमानित हैं; ये बनाने के समय, कप के आकार और ब्रांड के हिसाब से बदलते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai ini perkiraan per porsi dan bisa berbeda menurut lama penyeduhan, ukuran cangkir, dan merek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値は1杯あたりの目安です。抽出時間、カップの大きさ、ブランドによって変わります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores são aproximados por porção e variam conforme o tempo de preparo, o tamanho da xícara e a marca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения примерные, на одну порцию; они зависят от времени заваривания, объёма чашки и марки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值为每份的大致含量，会因冲泡时间、杯子大小和品牌而不同。"
          }
        }
      }
    },
