    "60 saniyelik dinlenme nabzı ve kısa bir uyku kaydı. Kişisel normalini bu ölçümler oluşturur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 60-second resting heart rate and a short sleep log. These build your personal baseline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "60 saniyelik dinlenme nabzı ve kısa bir uyku kaydı. Kişisel normalini bu ölçümler oluşturur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قياس نبض الراحة لمدة 60 ثانية وتسجيل قصير للنوم. من هذه القياسات يتكوّن معدلك الطبيعي الشخصي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "60 সেকেন্ডের বিশ্রামকালীন হার্ট রেট আর ঘুমের একটা ছোট রেকর্ড। এগুলো থেকেই আপনার ব্যক্তিগত স্বাভাবিক মাত্রা তৈরি হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "60 Sekunden Ruhepuls und ein kurzer Schlafeintrag. Daraus entsteht dein persönlicher Normalwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulso en reposo durante 60 segundos y un breve registro del sueño. Con estas mediciones se forma tu normal personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pouls au repos de 60 secondes et un court relevé de sommeil. Ces mesures établissent ta normale personnelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "60 सेकंड की आराम की धड़कन और नींद का छोटा-सा रिकॉर्ड। इन्हीं मापों से आपका निजी सामान्य स्तर बनता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung istirahat selama 60 detik dan catatan tidur singkat. Dari sinilah nilai normal pribadimu terbentuk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60秒の安静時心拍数と、短い睡眠の記録。これがあなたの基準値になります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequência cardíaca em repouso por 60 segundos e um registro rápido do sono. Essas medições formam o seu normal pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульс покоя за 60 секунд и короткая запись о сне. Из этих замеров складывается твоя личная норма."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60秒静息心率测量和简短的睡眠记录。这些会建立你的个人基准。"
          }
        }
      }
    },
