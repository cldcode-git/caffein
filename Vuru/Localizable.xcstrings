    "Şimdi tekrar ölçelim. Parmağını kameraya hafifçe koy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now let's measure again. Rest your finger gently on the camera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi tekrar ölçelim. Parmağını kameraya hafifçe koy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنقِس مجددًا الآن. ضع إصبعك برفق على الكاميرا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এবার আবার মাপি। ক্যামেরায় আঙুল আলতো করে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt messen wir noch mal. Leg deinen Finger sanft auf die Kamera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora volvamos a medir. Apoya el dedo suavemente sobre la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurons à nouveau. Pose doucement ton doigt sur l'appareil photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब दोबारा मापते हैं। उंगली कैमरे पर हल्के से रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang mari ukur lagi. Letakkan jarimu perlahan di kamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度測りましょう。指をカメラにそっと置いてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora vamos medir de novo. Apoie o dedo de leve na câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь измерим снова. Слегка приложи палец к камере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在再测一次。把手指轻轻放在摄像头上。"
          }
        }
      }
    },
