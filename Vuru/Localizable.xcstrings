    "Yatış ve uyanış saatini kontrol et; uyku süresi 1 ile 16 saat arasında olmalı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your bedtime and wake time; sleep must be between 1 and 16 hours."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatış ve uyanış saatini kontrol et; uyku süresi 1 ile 16 saat arasında olmalı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من وقتي النوم والاستيقاظ؛ يجب أن تكون مدة النوم بين 1 و16 ساعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমানো আর ওঠার সময় দেখে নিন; ঘুম 1 থেকে 16 ঘণ্টার মধ্যে হতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüf deine Schlafens- und Aufwachzeit; der Schlaf muss zwischen 1 und 16 Stunden liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu hora de acostarte y de despertarte; el sueño debe durar entre 1 y 16 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie tes heures de coucher et de réveil ; la nuit doit durer entre 1 et 16 heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने और उठने का समय जाँचें; नींद 1 से 16 घंटे के बीच होनी चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa jam tidur dan jam bangunmu; durasi tidur harus antara 1 dan 16 jam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時刻と起床時刻を確認してください。睡眠時間は1〜16時間の範囲で入力してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o horário de dormir e de acordar; o sono deve durar entre 1 e 16 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверь время отбоя и подъёма: сон должен длиться от 1 до 16 часов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查就寝和起床时间；睡眠时长必须在1到16小时之间。"
          }
        }
      }
    },
