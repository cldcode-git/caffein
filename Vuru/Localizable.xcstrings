            "state": "translated",
            "value": "Kafeinli günlerde daha gergin hissediyorsun"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشعر بتوتر أكبر في الأيام التي يكثر فيها الكافيين"
