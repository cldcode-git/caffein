    "Her atımda titreşim": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrate on every beat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her atımda titreşim"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اهتزاز مع كل نبضة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি স্পন্দনে ভাইব্রেশন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Schlag vibrieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
