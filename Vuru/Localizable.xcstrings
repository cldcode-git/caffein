    "%@ üzerinde kafein aldığın günlerde gerginlik puanın ortalama %@ puan daha yüksekti.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days with more than %@ of caffeine, your tension score was %@ points higher on average."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzerinde kafein aldığın günlerde gerginlik puanın ortalama %@ puan daha yüksekti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الأيام التي تناولت فيها أكثر من %@ من الكافيين، كانت درجة توترك أعلى بمعدل %@ نقطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব দিনে আপনি %@-এর বেশি ক্যাফেইন নিয়েছেন, সেসব দিনে আপনার টেনশন স্কোর গড়ে %@ পয়েন্ট বেশি ছিল।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit mehr als %@ Koffein lag deine Anspannung im Schnitt %@ Punkte höher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días con más de %@ de cafeína, tu nivel de tensión fue de media %@ puntos más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours à plus de %@ de caféine, ton score de tension était en moyenne %@ points plus élevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन दिनों आपने %@ से ज़्यादा कैफ़ीन लिया, उन दिनों आपका तनाव स्कोर औसतन %@ अंक ज़्यादा था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada hari dengan kafein lebih dari %@, skor tegangmu rata-rata %@ poin lebih tinggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェインが%@を超えた日は、緊張スコアが平均%@ポイント高めでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos dias com mais de %@ de cafeína, sua nota de tensão foi em média %@ pontos maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В дни, когда кофеина было больше %@, твоя оценка напряжения была в среднем на %@ балла выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡因超过%@的日子里，你的紧张评分平均高出%@分。"
          }
        }
      }
    },
    "%@ üzerinde kafein aldığın günlerin ertesi sabahı dinlenme nabzın ortalama %lld atım daha yüksekti.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The morning after days with more than %@ of caffeine, your resting heart rate was %lld bpm higher on average."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzerinde kafein aldığın günlerin ertesi sabahı dinlenme nabzın ortalama %lld atım daha yüksekti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الصباح التالي للأيام التي تناولت فيها أكثر من %@ من الكافيين، كان نبضك أثناء الراحة أعلى بمعدل %lld نبضة في الدقيقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব দিনে আপনি %@-এর বেশি ক্যাফেইন নিয়েছেন, তার পরের সকালে বিশ্রামকালীন হার্ট রেট গড়ে প্রতি মিনিটে %lld বিট বেশি ছিল।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Morgen nach Tagen mit mehr als %@ Koffein war dein Ruhepuls im Schnitt %lld Schläge höher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mañana después de los días con más de %@ de cafeína, tu pulso en reposo fue de media %lld lpm más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lendemain matin des jours à plus de %@ de caféine, ton pouls au repos était en moyenne %lld bpm plus élevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन दिनों आपने %@ से ज़्यादा कैफ़ीन लिया, उनकी अगली सुबह आराम के समय आपकी धड़कन औसतन %lld बीट प्रति मिनट ज़्यादा थी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagi setelah hari dengan kafein lebih dari %@, detak jantung istirahatmu rata-rata %lld bpm lebih tinggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェインが%@を超えた日の翌朝は、安静時心拍数が平均%lld bpm高めでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na manhã seguinte aos dias com mais de %@ de cafeína, sua frequência cardíaca em repouso foi em média %lld bpm maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утром после дней, когда кофеина было больше %@, пульс покоя был в среднем на %lld уд./мин выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡因超过%@的日子，第二天早上你的静息心率平均高出%lld次/分。"
          }
        }
      }
    },
