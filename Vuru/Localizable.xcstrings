    "Kişisel çıkarımlar için en az %lld günlük kayıt gerekiyor. Şu an %lld gün var.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal insights need at least %lld days of records. You have %lld so far."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel çıkarımlar için en az %lld günlük kayıt gerekiyor. Şu an %lld gün var."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج الاستنتاجات الشخصية إلى سجلات أيام لا يقل عددها عن %lld. عدد أيامك حتى الآن: %lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যক্তিগত পর্যবেক্ষণের জন্য অন্তত %lld দিনের রেকর্ড লাগবে। এখন পর্যন্ত %lld দিন আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für persönliche Erkenntnisse brauchst du mindestens %lld Tage mit Einträgen. Bisher sind es %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis personal necesita al menos %lld días de registros. Llevas %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les analyses personnelles nécessitent au moins %lld jours de données. Tu en as %lld pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी इनसाइट्स के लिए कम से कम %lld दिनों का रिकॉर्ड चाहिए। अभी %lld दिन हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wawasan pribadi butuh setidaknya %lld hari catatan. Sejauh ini ada %lld hari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーソナルインサイトには%lld日以上の記録が必要です。現在%lld日です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os insights pessoais precisam de pelo menos %lld dias de registros. Você tem %lld até agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для личных выводов нужны записи минимум за %lld дн. Сейчас есть: %lld дн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人洞察至少需要%lld天的记录。目前已有%lld天。"
          }
        }
      }
    },
