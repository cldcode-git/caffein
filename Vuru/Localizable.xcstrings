    "Kafein eğrisi ve son kahve saati bu saate göre hesaplanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The caffeine curve and last-coffee time are based on this."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein eğrisi ve son kahve saati bu saate göre hesaplanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب منحنى الكافيين وآخر موعد للقهوة بناءً على هذا الوقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাফেইন কার্ভ আর শেষ কফির সময় এর ভিত্তিতে হিসাব করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koffeinkurve und Zeit für den letzten Kaffee werden danach berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La curva de cafeína y la hora del último café se calculan según esta hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La courbe de caféine et l'heure du dernier café sont calculées à partir de cette heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैफ़ीन कर्व और आखिरी कॉफ़ी का समय इसी के आधार पर तय होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurva kafein dan waktu kopi terakhir dihitung berdasarkan jam ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェイン曲線と最後のコーヒー時刻はこの時刻をもとに計算します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A curva de cafeína e o horário do último café são calculados com base nesse horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этому времени рассчитываются кривая кофеина и время последнего кофе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡因曲线和最后一杯咖啡的时间都会据此计算。"
          }
        }
      }
    },
    "Kafein gerginliğini artırmıyor gibi görünüyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeine doesn't seem to raise your tension"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein gerginliğini artırmıyor gibi görünüyor"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدو أن الكافيين يزيد توترك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মনে হচ্ছে ক্যাফেইন আপনার টেনশন বাড়ায় না"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koffein scheint deine Anspannung nicht zu erhöhen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cafeína no parece aumentar tu tensión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caféine ne semble pas augmenter ta tension"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगता है कैफ़ीन आपका तनाव नहीं बढ़ाता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein tampaknya tidak meningkatkan keteganganmu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェインで緊張が高まってはいないようです"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cafeína não parece aumentar sua tensão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, кофеин не усиливает твоё напряжение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡因似乎没有加重你的紧张"
          }
        }
      }
    },
    "Kafein hassasiyeti kişiden kişiye çok değişir. Bazı ilaçlar, hamilelik, doğum kontrol hapları ve karaciğer sağlığı kafeinin vücuttan atılmasını yavaşlatır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeine sensitivity varies a lot between people. Some medicines, pregnancy, birth control pills and liver health slow down how fast caffeine leaves the body."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein hassasiyeti kişiden kişiye çok değişir. Bazı ilaçlar, hamilelik, doğum kontrol hapları ve karaciğer sağlığı kafeinin vücuttan atılmasını yavaşlatır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف الحساسية للكافيين كثيرًا من شخص لآخر. بعض الأدوية والحمل وحبوب منع الحمل وصحة الكبد تُبطئ خروج الكافيين من الجسم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাফেইনের প্রতি সংবেদনশীলতা মানুষভেদে অনেক আলাদা। কিছু ওষুধ, গর্ভাবস্থা, জন্মনিয়ন্ত্রণ বড়ি আর লিভারের স্বাস্থ্য শরীর থেকে ক্যাফেইন বের হওয়ার গতি কমিয়ে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie empfindlich jemand auf Koffein reagiert, ist sehr unterschiedlich. Manche Medikamente, Schwangerschaft, die Pille und die Lebergesundheit verlangsamen den Koffeinabbau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilidad a la cafeína varía mucho de una persona a otra. Algunos medicamentos, el embarazo, las píldoras anticonceptivas y la salud del hígado hacen que el cuerpo elimine la cafeína más despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensibilité à la caféine varie beaucoup d'une personne à l'autre. Certains médicaments, la grossesse, la pilule contraceptive et la santé du foie ralentissent l'élimination de la caféine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैफ़ीन के प्रति संवेदनशीलता हर व्यक्ति में बहुत अलग होती है। कुछ दवाएँ, गर्भावस्था, गर्भनिरोधक गोलियाँ और लिवर की सेहत शरीर से कैफ़ीन निकलने की रफ़्तार धीमी कर देती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kepekaan terhadap kafein sangat berbeda pada tiap orang. Beberapa obat, kehamilan, pil KB, dan kesehatan hati memperlambat pembuangan kafein dari tubuh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェインへの感受性は人によって大きく異なります。一部の薬、妊娠、経口避妊薬、肝臓の状態によって、カフェインが体から抜けるのが遅くなります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sensibilidade à cafeína varia muito de pessoa para pessoa. Alguns remédios, a gravidez, a pílula anticoncepcional e a saúde do fígado deixam mais lenta a eliminação da cafeína pelo corpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чувствительность к кофеину у всех очень разная. Некоторые лекарства, беременность, противозачаточные таблетки и состояние печени замедляют выведение кофеина из организма."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个人对咖啡因的敏感程度差别很大。某些药物、怀孕、避孕药和肝脏健康状况都会减慢咖啡因从体内排出的速度。"
          }
        }
      }
    },
    "Kafein saatlerin dengeli": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your caffeine timing is balanced"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein saatlerin dengeli"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيت الكافيين لديك متوازن"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ক্যাফেইনের সময় ভারসাম্যপূর্ণ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Koffein-Timing ist ausgewogen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus horarios de cafeína están equilibrados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes horaires de caféine sont équilibrés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कैफ़ीन का समय संतुलित है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu minum kafeinmu sudah seimbang"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェインをとる時間帯はバランスがとれています"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus horários de cafeína estão equilibrados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кофеин в правильное время"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的咖啡因摄入时间很均衡"
          }
        }
      }
    },
    "Kafein sende ne kadar sürüyor?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long does caffeine last for you?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein sende ne kadar sürüyor?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم يدوم الكافيين في جسمك؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার শরীরে ক্যাফেইন কতক্ষণ থাকে?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange wirkt Koffein bei dir?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto te dura la cafeína?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps la caféine agit-elle sur toi ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पर कैफ़ीन कितनी देर असर करता है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama kafein bertahan di tubuhmu?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェインはあなたの体にどのくらい残りますか？"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo a cafeína dura em você?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как долго на тебя действует кофеин?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡因在你体内持续多久？"
          }
        }
      }
    },
