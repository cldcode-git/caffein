    "%lld nefes egzersizinin ardından nabzın ortalama %lld atım yavaşladı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After %lld breathing sessions your heart rate slowed by %lld bpm on average."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nefes egzersizinin ardından nabzın ortalama %lld atım yavaşladı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد %lld من جلسات التنفس، تباطأ نبضك بمعدل %lld نبضة في الدقيقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld বার শ্বাসের ব্যায়ামের পর আপনার হার্ট রেট গড়ে প্রতি মিনিটে %lld বিট কমেছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %lld Atemübungen war dein Puls im Schnitt %lld Schläge langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras %lld sesiones de respiración, tu pulso bajó de media %lld lpm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après %lld séances de respiration, ton pouls a ralenti de %lld bpm en moyenne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld बार साँस के अभ्यास के बाद आपकी धड़कन औसतन %lld बीट प्रति मिनट धीमी हुई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah %lld sesi latihan napas, detak jantungmu rata-rata melambat %lld bpm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld回の呼吸エクササイズのあと、心拍数が平均%lld bpm下がりました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de %lld exercícios de respiração, sua frequência cardíaca caiu em média %lld bpm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После дыхательных упражнений (%lld) пульс в среднем замедлялся на %lld уд./мин."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld次呼吸练习后，你的心率平均降低了%lld次/分。"
          }
        }
      }
    },
