    "%lld gecenin %lld tanesinde yatarken vücudunda %@'den fazla kafein vardı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %2$lld of %1$lld nights you went to bed with more than %3$@ of caffeine in your body."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gecenin %lld tanesinde yatarken vücudunda %@'den fazla kafein vardı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %2$lld من أصل %1$lld من الليالي، ذهبت إلى النوم وفي جسمك أكثر من %3$@ من الكافيين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld রাতের মধ্যে %lld রাতে ঘুমাতে যাওয়ার সময় আপনার শরীরে %@-এর বেশি ক্যাফেইন ছিল।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %2$lld von %1$lld Nächten hattest du beim Zubettgehen mehr als %3$@ Koffein im Körper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %2$lld de %1$lld noches te acostaste con más de %3$@ de cafeína en el cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld nuits sur %1$lld, ton corps contenait plus de %3$@ de caféine au moment du coucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld में से %lld रातों को सोते समय आपके शरीर में %@ से ज़्यादा कैफ़ीन था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada %2$lld dari %1$lld malam, kamu tidur dengan lebih dari %3$@ kafein di tubuhmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld晩のうち%2$lld晩は、体内に%3$@を超えるカフェインが残ったまま寝ていました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %2$lld de %1$lld noites, você foi dormir com mais de %3$@ de cafeína no corpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %2$lld из %1$lld ночей к отбою в организме было больше %3$@ кофеина."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$lld个晚上中，有%2$lld晚你上床时体内的咖啡因超过%3$@。"
          }
        }
      }
    },
