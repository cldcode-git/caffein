    "Yine de iyi hissettiriyorsa sürdürmeye değer; farklı saatlerde denemeyi düşünebilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it still feels good it's worth keeping up; you could try it at different times of day."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine de iyi hissettiriyorsa sürdürmeye değer; farklı saatlerde denemeyi düşünebilirsin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان يُشعرك بالراحة، فالأمر يستحق الاستمرار؛ يمكنك تجربته في أوقات مختلفة من اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তবুও ভালো লাগলে চালিয়ে যাওয়ার মতো; দিনের ভিন্ন সময়ে চেষ্টা করে দেখতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es dir trotzdem guttut, bleib dran; probier es vielleicht zu anderen Tageszeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aun así te sienta bien, vale la pena seguir; podrías probar a otras horas del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ça te fait quand même du bien, ça vaut la peine de continuer ; tu peux essayer à d'autres moments de la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर फिर भी अच्छा लगता है तो जारी रखें; आप इसे दिन के अलग-अलग समय पर आज़मा सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau tetap terasa enak, layak diteruskan; kamu bisa mencobanya di waktu yang berbeda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも気分が良いなら続ける価値があります。時間帯を変えて試してみるのもいいでしょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ainda assim faz você se sentir bem, vale a pena continuar; você pode tentar em outros horários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если тебе всё равно становится лучше, продолжай; можно попробовать в другое время дня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果感觉还是不错，就值得坚持；可以试试在一天中不同的时间练习。"
          }
        }
      }
    },
    "Yoğun kafein günlerinin ertesi sabahı nabzın daha yüksek": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your heart rate is higher the morning after heavy caffeine days"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoğun kafein günlerinin ertesi sabahı nabzın daha yüksek"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نبضك أعلى في الصباح التالي لأيام الكافيين المرتفع"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেশি ক্যাফেইনের দিনের পরের সকালে আপনার হার্ট রেট বেশি থাকে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Morgen nach koffeinreichen Tagen ist dein Puls höher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulso es más alto la mañana después de días con mucha cafeína"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pouls est plus élevé le lendemain matin des journées riches en caféine"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा कैफ़ीन वाले दिनों की अगली सुबह आपकी धड़कन ज़्यादा होती है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantungmu lebih tinggi di pagi setelah hari dengan banyak kafein"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェインが多かった日の翌朝は心拍数が高めです"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus batimentos ficam mais altos na manhã seguinte a dias com muita cafeína"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утром после дней с большим количеством кофеина пульс выше"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡因摄入多的日子，第二天早上你的心率更高"
          }
        }
      }
    },
