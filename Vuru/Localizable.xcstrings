    "Sağlık izni verilmedi. Ayarlar → Sağlık → Veri Erişimi bölümünden açabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health access was not allowed. You can turn it on in Settings → Health → Data Access."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık izni verilmedi. Ayarlar → Sağlık → Veri Erişimi bölümünden açabilirsin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسمح بالوصول إلى صحتي. يمكنك تفعيله من الإعدادات → صحتي → الوصول إلى البيانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাস্থ্য অ্যাক্সেসের অনুমতি দেওয়া হয়নি। সেটিংস → স্বাস্থ্য → ডেটা অ্যাক্সেস থেকে চালু করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-Zugriff wurde nicht erlaubt. Du kannst ihn unter Einstellungen → Health → Datenzugriff & Geräte aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se permitió el acceso a Salud. Puedes activarlo en Ajustes → Salud → Acceso a datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à Santé n'a pas été autorisé. Tu peux l'activer dans Réglages → Santé → Accès aux données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वास्थ्य की अनुमति नहीं दी गई। आप इसे सेटिंग्स → स्वास्थ्य → डेटा एक्सेस में चालू कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Kesehatan tidak diizinkan. Kamu bisa menyalakannya di Pengaturan → Kesehatan → Akses Data & Perangkat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアへのアクセスが許可されていません。設定 → ヘルスケア → データアクセスとデバイス からオンにできます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao Saúde não foi permitido. Você pode ativá-lo em Ajustes → Saúde → Acesso a Dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к Здоровью не разрешён. Включить его можно в Настройки → Здоровье → Доступ к данным и устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未获得健康权限。你可以在“设置 → 健康 → 数据访问与设备”中开启。"
          }
        }
      }
    },
