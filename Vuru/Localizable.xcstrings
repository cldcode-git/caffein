    "Vücudunda şu an yaklaşık %@ kafein var. Bugün için bir sonraki kahveyi atlamak gerginliğine iyi gelebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is about %@ of caffeine in your body right now. Skipping the next coffee today may ease your tension."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunda şu an yaklaşık %@ kafein var. Bugün için bir sonraki kahveyi atlamak gerginliğine iyi gelebilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد في جسمك الآن نحو %@ من الكافيين. قد يساعد تخطي القهوة التالية اليوم في تخفيف توترك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন আপনার শরীরে প্রায় %@ ক্যাফেইন আছে। আজ পরের কফিটা বাদ দিলে টেনশন কমতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade hast du etwa %@ Koffein im Körper. Den nächsten Kaffee heute auszulassen, kann deine Anspannung lindern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo tienes unos %@ de cafeína en el cuerpo. Saltarte el próximo café de hoy puede aliviar tu tensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton corps contient en ce moment environ %@ de caféine. Sauter le prochain café aujourd'hui pourrait apaiser ta tension."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी आपके शरीर में लगभग %@ कैफ़ीन है। आज अगली कॉफ़ी छोड़ देने से तनाव कम हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini ada sekitar %@ kafein di tubuhmu. Melewatkan kopi berikutnya hari ini bisa membantu meredakan keteganganmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま体内に約%@のカフェインがあります。今日は次のコーヒーを控えると、緊張がやわらぐかもしれません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você tem cerca de %@ de cafeína no corpo. Pular o próximo café de hoje pode aliviar sua tensão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас в организме около %@ кофеина. Если пропустить следующий кофе сегодня, напряжение может уменьшиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你体内目前约有%@咖啡因。今天跳过下一杯咖啡可能有助于缓解紧张。"
          }
        }
      }
    },
    "Vücudunda şu an yüksek miktarda kafein var": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a lot of caffeine in your body right now"
          }
        },
        "tr": {
