    "Daha çok kafein aldığın günlerde gerginlik puanın daha yüksek değildi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days with more caffeine your tension score was not higher."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha çok kafein aldığın günlerde gerginlik puanın daha yüksek değildi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الأيام التي تناولت فيها كافيين أكثر، لم تكن درجة توترك أعلى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেশি ক্যাফেইনের দিনগুলোতে আপনার টেনশন স্কোর বেশি ছিল না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit mehr Koffein war deine Anspannung nicht höher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días con más cafeína, tu nivel de tensión no fue más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours avec plus de caféine, ton score de tension n'était pas plus élevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन दिनों आपने ज़्यादा कैफ़ीन लिया, उन दिनों आपका तनाव स्कोर ज़्यादा नहीं था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada hari dengan lebih banyak kafein, skor tegangmu tidak lebih tinggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カフェインが多い日でも、緊張スコアは高くなっていませんでした。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos dias com mais cafeína, sua nota de tensão não foi maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В дни с большим количеством кофеина твоя оценка напряжения не была выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咖啡因摄入较多的日子里，你的紧张评分并没有更高。"
          }
        }
      }
    },
