    "Arka kamerayı ve flaşı parmak ucunla hafifçe ört.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently cover the back camera and flash with your fingertip."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka kamerayı ve flaşı parmak ucunla hafifçe ört."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غطِّ الكاميرا الخلفية والفلاش برفق بطرف إصبعك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেছনের ক্যামেরা আর ফ্ল্যাশ আঙুলের ডগা দিয়ে আলতো করে ঢেকে দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deck die Rückkamera und den Blitz sanft mit der Fingerkuppe ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubre suavemente la cámara trasera y el flash con la yema del dedo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvre doucement l'appareil photo arrière et le flash du bout du doigt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीछे के कैमरे और फ़्लैश को उंगली के सिरे से हल्के से ढकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup kamera belakang dan lampu kilat dengan ujung jarimu secara perlahan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背面カメラとフラッシュを指先でそっと覆ってください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubra de leve a câmera traseira e o flash com a ponta do dedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слегка прикрой пальцем заднюю камеру и вспышку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用指尖轻轻盖住后置摄像头和闪光灯。"
          }
        }
      }
    },
