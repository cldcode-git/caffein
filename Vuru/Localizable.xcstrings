    "Bir iki bardak su iç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink a glass or two of water."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir iki bardak su iç."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشرب كوبًا أو كوبين من الماء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক-দুই গ্লাস পানি পান করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trink ein, zwei Gläser Wasser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe uno o dos vasos de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bois un ou deux verres d'eau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक-दो गिलास पानी पिएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum satu atau dua gelas air."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水を1〜2杯飲みましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba um ou dois copos de água."
          }
        },
        "ru": {
          "stringUnit": {
