            "state": "translated",
            "value": "周日晚上的每周总结"
          }
        }
      }
    },
    "Pil tasarrufu için durdu. Devam etmek için dokun.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused to save battery. Tap to continue."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil tasarrufu için durdu. Devam etmek için dokun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف لتوفير البطارية. اضغط للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাটারি বাঁচাতে থেমে গেছে। চালিয়ে যেতে ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert, um Akku zu sparen. Tippe, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa para ahorrar batería. Toca para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause pour économiser la batterie. Touche pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैटरी बचाने के लिए रुका। जारी रखने के लिए टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda untuk menghemat baterai. Ketuk untuk melanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー節約のため停止しました。タップして再開。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado para economizar bateria. Toque para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено для экономии заряда. Коснись, чтобы продолжить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为节省电量已暂停。轻点继续。"
          }
        }
      }
    },
