        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون الكافيين المتأخر يُقصّر نومك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেরিতে নেওয়া ক্যাফেইন হয়তো আপনার ঘুম কমিয়ে দিচ্ছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätes Koffein verkürzt vielleicht deinen Schlaf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cafeína tardía podría estar acortando tu sueño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caféine tardive pourrait raccourcir ton sommeil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देर से लिया कैफ़ीन शायद आपकी नींद कम कर रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafein yang terlambat mungkin memperpendek tidurmu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅い時間のカフェインで睡眠が短くなっているかもしれません"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cafeína tarde pode estar encurtando seu sono"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поздний кофеин может сокращать твой сон"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚间咖啡因可能在缩短你的睡眠"
          }
        }
      }
    },
