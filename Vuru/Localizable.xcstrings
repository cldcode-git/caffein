    "Otur ve yavaş nefes al: 4 saniye al, 6 saniyede ver.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit down and breathe slowly: 4 seconds in, 6 seconds out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otur ve yavaş nefes al: 4 saniye al, 6 saniyede ver."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجلس وتنفّس ببطء: شهيق 4 ثوانٍ، وزفير 6 ثوانٍ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বসে পড়ুন আর ধীরে শ্বাস নিন: 4 সেকেন্ড নিন, 6 সেকেন্ডে ছাড়ুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich und atme langsam: 4 Sekunden ein, 6 Sekunden aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate y respira despacio: 4 segundos inspirando, 6 espirando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assieds-toi et respire lentement : inspire 4 secondes, expire 6 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैठ जाएँ और धीरे-धीरे साँस लें: 4 सेकंड अंदर, 6 सेकंड बाहर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Duduk dan bernapas pelan: tarik 4 detik, embuskan 6 detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座って、ゆっくり呼吸しましょう：4秒吸って、6秒で吐きます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente-se e respire devagar: 4 segundos inspirando, 6 expirando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сядь и дыши медленно: вдох 4 секунды, выдох 6 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐下，慢慢呼吸：吸气4秒，呼气6秒。"
          }
        }
      }
    },
    "Parmağını arka kameraya koy": {
