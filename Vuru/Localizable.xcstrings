    "Yataktan kalkmadan ya da kalktıktan hemen sonra, oturarak ölç. Kahveden önce ölçmek kişisel normalini daha doğru yapar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure before getting up or right after, sitting down. Measuring before coffee makes your personal normal more accurate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yataktan kalkmadan ya da kalktıktan hemen sonra, oturarak ölç. Kahveden önce ölçmek kişisel normalini daha doğru yapar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِس قبل أن تنهض من السرير أو بعد النهوض مباشرة، وأنت جالس. القياس قبل القهوة يجعل معدلك الطبيعي الشخصي أدق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিছানা ছাড়ার আগে বা উঠেই, বসে মাপুন। কফির আগে মাপলে আপনার ব্যক্তিগত স্বাভাবিক মাত্রা আরও নির্ভুল হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss im Sitzen, noch vor dem Aufstehen oder direkt danach. Vor dem Kaffee zu messen macht deinen Normalwert genauer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide antes de levantarte o justo después, en posición sentada. Medir antes del café hace que tu normal personal sea más preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure avant de te lever ou juste après, en position assise. Mesurer avant le café rend ta normale personnelle plus précise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिस्तर से उठने से पहले या उठते ही, बैठकर मापें। कॉफ़ी से पहले मापने से आपका निजी सामान्य स्तर ज़्यादा सटीक बनता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur sebelum bangun dari tempat tidur atau sesaat setelahnya, sambil duduk. Mengukur sebelum minum kopi membuat nilai normal pribadimu lebih akurat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起き上がる前か、起きてすぐ、座って測りましょう。コーヒーの前に測ると、基準値がより正確になります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça antes de sair da cama ou logo depois, na posição sentada. Medir antes do café deixa seu normal pessoal mais preciso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряй сидя — ещё до того, как встанешь, или сразу после. Замер до кофе делает твою личную норму точнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床前或刚起床后坐着测量。在喝咖啡前测量能让你的个人正常值更准确。"
          }
        }
      }
    },
    "Yatarken az kafein": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
