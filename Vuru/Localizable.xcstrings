          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a tomar tu último café un poco antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie de prendre ton dernier café un peu plus tôt"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आखिरी कॉफ़ी थोड़ा पहले लेकर देखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba majukan kopi terakhirmu sedikit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のコーヒーを少し早めてみましょう"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente tomar seu último café um pouco mais cedo"
          }
        },
        "ru": {
