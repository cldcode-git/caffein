    "Bildirim izni verilmedi. Ayarlar → Bildirimler → Caffein bölümünden açabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are not allowed. You can turn them on in Settings → Notifications → Caffein."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni verilmedi. Ayarlar → Bildirimler → Caffein bölümünden açabilirsin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات غير مسموح بها. يمكنك تفعيلها من الإعدادات → الإشعارات → Caffein."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশনের অনুমতি দেওয়া হয়নি। সেটিংস → নোটিফিকেশন → Caffein থেকে চালু করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind nicht erlaubt. Du kannst sie unter Einstellungen → Mitteilungen → Caffein aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones no están permitidas. Puedes activarlas en Ajustes → Notificaciones → Caffein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications ne sont pas autorisées. Tu peux les activer dans Réglages → Notifications → Caffein."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाओं की अनुमति नहीं है। आप इन्हें सेटिंग्स → सूचनाएँ → Caffein में चालू कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi tidak diizinkan. Kamu bisa menyalakannya di Pengaturan → Notifikasi → Caffein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が許可されていません。設定 → 通知 → Caffein からオンにできます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações não estão permitidas. Você pode ativá-las em Ajustes → Notificações → Caffein."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления не разрешены. Включить их можно в Настройки → Уведомления → Caffein."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未开启通知权限。你可以在“设置 → 通知 → Caffein”中开启。"
          }
        }
      }
    },
    "Bilmekte fayda var": {
      "localizations": {
