    "Ne kadar kafeinin sana uygun olduğu yaşına ve kilona göre değişir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much caffeine suits you depends on your age and weight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar kafeinin sana uygun olduğu yaşına ve kilona göre değişir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد كمية الكافيين المناسبة لك على عمرك ووزنك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্য কতটা ক্যাফেইন ঠিক, তা আপনার বয়স আর ওজনের ওপর নির্ভর করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Koffein dir guttut, hängt von deinem Alter und Gewicht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cantidad de cafeína adecuada para ti depende de tu edad y tu peso."
